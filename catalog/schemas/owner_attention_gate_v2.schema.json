{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/owner_attention_gate_v2.schema.json",
  "$defs": {
    "policyV2": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "policy_id", "as_of", "status", "owner", "repository", "purpose", "decisions", "owner_attention_triggers", "route_authority", "merge_approval", "github_checks", "merge_preconditions", "post_merge", "invariants", "non_claims"],
      "properties": {
        "schema": {"const": "smial.owner-attention-gate"}, "schema_version": {"const": "2.0"}, "policy_id": {"const": "OWNER_ATTENTION_GATE_V2"},
        "as_of": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"}, "status": {"type": "string"}, "owner": {"const": "GOAL_OWNER"}, "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "purpose": {"type": "string", "minLength": 20},
        "decisions": {"type": "array", "prefixItems": [{"const": "AUTONOMOUS"}, {"const": "OWNER_ATTENTION_REQUIRED"}, {"const": "DENY"}], "items": false},
        "owner_attention_triggers": {"type": "object", "additionalProperties": false, "required": ["auth_or_access_recovery", "material_owner_decision", "user_only_activation", "external_material_action", "unresolved_safety_or_truth_conflict"], "properties": {"auth_or_access_recovery": {"const": "AUTH_OR_ACCESS_RECOVERY"}, "material_owner_decision": {"const": "MATERIAL_OWNER_DECISION"}, "user_only_activation": {"const": "USER_ONLY_ACTIVATION"}, "external_material_action": {"const": "EXTERNAL_MATERIAL_ACTION"}, "unresolved_safety_or_truth_conflict": {"const": "UNRESOLVED_SAFETY_OR_TRUTH_CONFLICT"}}},
        "route_authority": {"type": "object", "additionalProperties": false, "required": ["DIRECT_CODEX_DELIVERY", "DIRECT_CURSOR_DELIVERY", "DESIGN_ONLY", "LEGACY_GITHUB_BATON_DORMANT"], "properties": {"DIRECT_CODEX_DELIVERY": {"$ref": "#/$defs/routePolicy"}, "DIRECT_CURSOR_DELIVERY": {"$ref": "#/$defs/routePolicy"}, "DESIGN_ONLY": {"$ref": "#/$defs/routePolicy"}, "LEGACY_GITHUB_BATON_DORMANT": {"$ref": "#/$defs/routePolicy"}}},
        "merge_approval": {"type": "object", "additionalProperties": false, "required": ["exact_phrase_pattern", "bind_repository", "bind_pr_number", "bind_head_sha"], "properties": {"exact_phrase_pattern": {"type": "string"}, "bind_repository": {"const": true}, "bind_pr_number": {"const": true}, "bind_head_sha": {"const": true}}},
        "github_checks": {"type": "object", "additionalProperties": false, "required": ["workflow", "workflow_file", "pull_request_event", "required_jobs", "accepted_conclusion"], "properties": {"workflow": {"type": "string", "minLength": 1}, "workflow_file": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._/-]+\\.ya?ml$"}, "pull_request_event": {"enum": ["pull_request", "pull_request_target"]}, "required_jobs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "accepted_conclusion": {"const": "success"}}},
        "merge_preconditions": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
        "post_merge": {"type": "object", "additionalProperties": false, "required": ["exact_main_readback_required", "main_ci_required", "branch_deletion_forbidden", "settings_change_forbidden"], "properties": {"exact_main_readback_required": {"const": true}, "main_ci_required": {"const": true}, "branch_deletion_forbidden": {"const": true}, "settings_change_forbidden": {"const": true}}},
        "invariants": {"type": "object", "additionalProperties": false, "required": ["scope_must_be_bound", "stricter_task_stop_wins", "passing_tests_do_not_grant_canonical_done", "owner_attention_is_not_a_failed_machine_check_override", "historical_receipts_are_append_only", "project_sources_activation_is_separate"], "properties": {"scope_must_be_bound": {"const": true}, "stricter_task_stop_wins": {"const": true}, "passing_tests_do_not_grant_canonical_done": {"const": true}, "owner_attention_is_not_a_failed_machine_check_override": {"const": true}, "historical_receipts_are_append_only": {"const": true}, "project_sources_activation_is_separate": {"const": true}}},
        "non_claims": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "routePolicy": {"type": "object", "additionalProperties": false, "required": ["allowed_actors", "autonomous_action_classes", "ordinary_merge"], "properties": {"allowed_actors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GPT", "CODEX", "CURSOR"]}}, "autonomous_action_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["READ_ONLY", "ROUTINE_ENGINEERING", "GITHUB_TRANSPORT"]}}, "ordinary_merge": {"enum": ["EXACT_OWNER_APPROVAL_AND_MACHINE_GATE", "FORBIDDEN"]}}},
    "requestV2": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "repository", "route", "actor", "action_class", "scope_bound", "stricter_stop_active", "triggers", "owner_approval", "merge_checks"],
      "properties": {
        "schema": {"const": "smial.owner-attention-request"}, "schema_version": {"const": "2.0"}, "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "route": {"enum": ["DIRECT_CODEX_DELIVERY", "DIRECT_CURSOR_DELIVERY", "DESIGN_ONLY", "LEGACY_GITHUB_BATON_DORMANT"]}, "actor": {"enum": ["GPT", "CODEX", "CURSOR"]}, "action_class": {"enum": ["READ_ONLY", "ROUTINE_ENGINEERING", "GITHUB_TRANSPORT", "MERGE_PULL_REQUEST"]}, "scope_bound": {"type": "boolean"}, "stricter_stop_active": {"type": "boolean"},
        "triggers": {"type": "object", "additionalProperties": false, "required": ["auth_or_access_recovery", "material_owner_decision", "user_only_activation", "external_material_action", "unresolved_safety_or_truth_conflict"], "properties": {"auth_or_access_recovery": {"type": "boolean"}, "material_owner_decision": {"type": "boolean"}, "user_only_activation": {"type": "boolean"}, "external_material_action": {"type": "boolean"}, "unresolved_safety_or_truth_conflict": {"type": "boolean"}}},
        "owner_approval": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["phrase", "pr_number", "head_sha", "context_receipt_sha256", "context_route"], "properties": {"phrase": {"type": "string"}, "pr_number": {"type": "integer", "minimum": 1}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "context_route": {"enum": ["DIRECT_CODEX_DELIVERY", "DIRECT_CURSOR_DELIVERY"]}}}]},
        "merge_checks": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["pr_number", "observed_head_sha", "observed_tree_sha", "context_receipt_sha256", "context_route", "exact_pr_head_bound", "context_receipt_bound", "required_tests_pass", "ci_exact_head_pass", "full_gate_pass", "factory_fit_pass", "write_set_pass", "secret_scan_pass", "mergeable", "no_unresolved_reviews", "standard_merge", "branch_preserved", "settings_unchanged"], "properties": {"pr_number": {"type": "integer", "minimum": 1}, "observed_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "observed_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "context_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "context_route": {"enum": ["DIRECT_CODEX_DELIVERY", "DIRECT_CURSOR_DELIVERY"]}, "exact_pr_head_bound": {"type": "boolean"}, "context_receipt_bound": {"type": "boolean"}, "required_tests_pass": {"type": "boolean"}, "ci_exact_head_pass": {"type": "boolean"}, "full_gate_pass": {"type": "boolean"}, "factory_fit_pass": {"type": "boolean"}, "write_set_pass": {"type": "boolean"}, "secret_scan_pass": {"type": "boolean"}, "mergeable": {"type": "boolean"}, "no_unresolved_reviews": {"type": "boolean"}, "standard_merge": {"type": "boolean"}, "branch_preserved": {"type": "boolean"}, "settings_unchanged": {"type": "boolean"}}}]}
      }
    }
  },
  "oneOf": [{"$ref": "#/$defs/policyV2"}, {"$ref": "#/$defs/requestV2"}]
}
