{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://catalog/schemas/task25_outcome_evidence.schema.json",
  "title": "TASK-25 outcome evidence contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "task_id",
    "atom_id",
    "fixture_kind",
    "records",
    "adversarial_mutations"
  ],
  "properties": {
    "schema": {"const": "smial.task25.outcome-evidence"},
    "schema_version": {"const": "1.0"},
    "task_id": {"const": "TASK-25"},
    "atom_id": {"const": "T25-A2_FROZEN_OUTCOME_LABEL_AND_PIT_CONTRACT_V1"},
    "fixture_kind": {"const": "SYNTHETIC_GOLDEN_ONLY"},
    "records": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/outcome_evidence"}
    },
    "adversarial_mutations": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/adversarial_mutation"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal_or_null": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {"type": "null"}
      ]
    },
    "notional": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_amount_atomic",
            "input_mint",
            "input_decimals",
            "quote_mint",
            "quote_decimals",
            "latency_budget_ms",
            "freshness_max_age_ms",
            "observed_age_ms"
          ],
          "properties": {
            "input_amount_atomic": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "input_mint": {"type": "string", "minLength": 3},
            "input_decimals": {"type": "integer", "minimum": 0, "maximum": 30},
            "quote_mint": {"type": "string", "minLength": 3},
            "quote_decimals": {"type": "integer", "minimum": 0, "maximum": 30},
            "latency_budget_ms": {"type": "integer", "minimum": 1},
            "freshness_max_age_ms": {"type": "integer", "minimum": 0},
            "observed_age_ms": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "inventory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "remaining_inventory_atomic",
            "remaining_inventory_mint",
            "remaining_inventory_decimals",
            "recovery_lower_bound_decimal",
            "recovery_upper_bound_decimal",
            "recovery_unit",
            "recovery_currency_or_mint",
            "failed_exit_state"
          ],
          "properties": {
            "state": {"enum": ["FLAT", "RECOVERED", "NOT_APPLICABLE"]},
            "remaining_inventory_atomic": {"const": "0"},
            "remaining_inventory_mint": {"type": "null"},
            "remaining_inventory_decimals": {"type": "null"},
            "recovery_lower_bound_decimal": {"type": "null"},
            "recovery_upper_bound_decimal": {"type": "null"},
            "recovery_unit": {"type": "null"},
            "recovery_currency_or_mint": {"type": "null"},
            "failed_exit_state": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "remaining_inventory_atomic",
            "remaining_inventory_mint",
            "remaining_inventory_decimals",
            "recovery_lower_bound_decimal",
            "recovery_upper_bound_decimal",
            "recovery_unit",
            "recovery_currency_or_mint",
            "failed_exit_state"
          ],
          "properties": {
            "state": {"const": "OPEN"},
            "remaining_inventory_atomic": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "remaining_inventory_mint": {"type": "string", "minLength": 3},
            "remaining_inventory_decimals": {"type": "integer", "minimum": 0, "maximum": 30},
            "recovery_lower_bound_decimal": {"type": "null"},
            "recovery_upper_bound_decimal": {"type": "null"},
            "recovery_unit": {"type": "null"},
            "recovery_currency_or_mint": {"type": "null"},
            "failed_exit_state": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "remaining_inventory_atomic",
            "remaining_inventory_mint",
            "remaining_inventory_decimals",
            "recovery_lower_bound_decimal",
            "recovery_upper_bound_decimal",
            "recovery_unit",
            "recovery_currency_or_mint",
            "failed_exit_state"
          ],
          "properties": {
            "state": {"const": "UNRESOLVED_REQUIRES_RECOVERY"},
            "remaining_inventory_atomic": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "remaining_inventory_mint": {"type": "string", "minLength": 3},
            "remaining_inventory_decimals": {"type": "integer", "minimum": 0, "maximum": 30},
            "recovery_lower_bound_decimal": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            "recovery_upper_bound_decimal": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            "recovery_unit": {"type": "string", "minLength": 1},
            "recovery_currency_or_mint": {"type": "string", "minLength": 3},
            "failed_exit_state": {
              "enum": ["NO_ROUTE", "EXIT_FAILED", "POOL_DEAD", "UNKNOWN_REQUIRES_RECONCILIATION"]
            }
          }
        }
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_at",
        "observed_at",
        "first_reliable_available_at",
        "available_to_strategy_at",
        "ingested_at",
        "measured_as_of"
      ],
      "properties": {
        "event_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "first_reliable_available_at": {"type": "string", "format": "date-time"},
        "available_to_strategy_at": {"type": "string", "format": "date-time"},
        "ingested_at": {"type": "string", "format": "date-time"},
        "measured_as_of": {"type": "string", "format": "date-time"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_asset_ids",
        "quote_attempt_ids",
        "execution_attempt_ids",
        "cashflow_reference_ids",
        "content_sha256"
      ],
      "properties": {
        "source_asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "quote_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "execution_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "cashflow_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcome_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "case_id",
        "source_scope",
        "label",
        "assessment",
        "evidence_basis",
        "claim_scope",
        "value_decimal",
        "unit",
        "route_state",
        "fill_state",
        "cashflow_state",
        "path_state",
        "notional",
        "inventory",
        "timestamps",
        "lineage",
        "quality_flags"
      ],
      "properties": {
        "record_id": {"type": "string", "pattern": "^T25-GOLDEN-[0-9]{3}$"},
        "case_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "source_scope": {"enum": ["SYNTHETIC_GOLDEN", "T21_R2_DEVELOPMENT"]},
        "label": {"enum": ["TOUCH", "FILLABLE", "QUOTE_EXIT", "REALIZED_VWAP", "NET", "PATH_RISK"]},
        "assessment": {"enum": ["SUPPORTED", "REFUTED", "UNKNOWN", "NOT_APPLICABLE"]},
        "evidence_basis": {
          "enum": [
            "REFERENCE_PRICE_PATH",
            "DISCRETE_PANEL_GRID",
            "CONTEMPORANEOUS_QUOTE",
            "ACTUAL_RECONCILED_FILLS",
            "SETTLED_CASHFLOW",
            "PATH_STATE_EVIDENCE",
            "NONE"
          ]
        },
        "claim_scope": {
          "enum": [
            "TOUCH_WITHIN_HORIZON",
            "OBSERVED_GRID_CROSSING",
            "POINT_IN_TIME_QUOTE",
            "ACTUAL_FILL_SERIES",
            "SETTLED_CASHFLOW",
            "DISCRETE_PATH_GRID",
            "CONTINUOUS_PATH_METRICS",
            "TERMINAL_PATH_STATE"
          ]
        },
        "value_decimal": {"$ref": "#/$defs/decimal_or_null"},
        "unit": {
          "oneOf": [
            {"enum": ["RETURN_DECIMAL", "PRICE_RATIO", "PATH_RISK_SCORE"]},
            {"type": "null"}
          ]
        },
        "route_state": {
          "enum": ["QUOTE_AVAILABLE", "NO_ROUTE", "STALE_QUOTE", "PROVIDER_ERROR", "INVALID_RESPONSE", "TIMEOUT", "NOT_APPLICABLE"]
        },
        "fill_state": {"enum": ["ACTUAL_FILLS_RECONCILED", "ACTUAL_FILLS_NOT_OBSERVED", "NOT_APPLICABLE"]},
        "cashflow_state": {"enum": ["SETTLED_COMPLETE", "FEE_MODEL_UNAVAILABLE", "CASHFLOW_NOT_OBSERVED", "NOT_APPLICABLE"]},
        "path_state": {"enum": ["CONTINUOUS_COMPLETE", "SPARSE_DISCRETE", "POOL_DEAD", "MISSING_EXIT", "UNOBSERVED", "NOT_APPLICABLE"]},
        "notional": {"$ref": "#/$defs/notional"},
        "inventory": {"$ref": "#/$defs/inventory"},
        "timestamps": {"$ref": "#/$defs/timestamps"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "quality_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"assessment": {"enum": ["UNKNOWN", "NOT_APPLICABLE"]}}},
          "then": {
            "properties": {
              "value_decimal": {"type": "null"},
              "unit": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"label": {"enum": ["FILLABLE", "QUOTE_EXIT"]}}},
          "then": {
            "properties": {
              "evidence_basis": {"const": "CONTEMPORANEOUS_QUOTE"},
              "claim_scope": {"const": "POINT_IN_TIME_QUOTE"},
              "notional": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"label": {"enum": ["TOUCH", "REALIZED_VWAP", "NET", "PATH_RISK"]}}},
          "then": {"properties": {"notional": {"type": "null"}}}
        }
      ]
    },
    "adversarial_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "base_record_id", "json_pointer", "replacement", "expected_error"],
      "properties": {
        "mutation_id": {"type": "string", "pattern": "^ADV-[0-9]{2}-[A-Z0-9_]+$"},
        "base_record_id": {"type": "string", "pattern": "^T25-GOLDEN-[0-9]{3}$"},
        "json_pointer": {"type": "string", "pattern": "^/[^/]+(?:/[^/]+)*$"},
        "replacement": {},
        "expected_error": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
      }
    }
  }
}
