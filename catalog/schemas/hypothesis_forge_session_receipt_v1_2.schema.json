{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/hypothesis_forge_session_receipt_v1_2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "session_state",
    "evidence_epoch_sha256",
    "focus_key_sha256",
    "search_key_sha256",
    "prompt_version",
    "live_git_head",
    "store_inventory_digest",
    "candidate_ids",
    "selected_candidate_id",
    "runner_up_candidate_id",
    "critic_input_packet_sha256",
    "critic_result_sha256",
    "critic_terminal",
    "lane_classifier_terminal",
    "decision_event_ids",
    "next",
    "authority",
    "no_git_fence_receipt",
    "created_at",
    "diagnostics"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "session_state": {"const": "SYNTHESIS_COMPLETE"},
    "evidence_epoch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "focus_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "search_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_version": {"const": "HFIC-V1.2"},
    "live_git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "store_inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {"type": "string", "pattern": "^HFIC-CAND-[0-9A-F]{12,64}$"}
    },
    "selected_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^HFIC-CAND-[0-9A-F]{12,64}$"
    },
    "critic_launched": {"type": "boolean"},
    "forge_context_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_up_candidate_id": {
      "type": "string",
      "pattern": "^HFIC-CAND-[0-9A-F]{12,64}$"
    },
    "critic_input_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "critic_result_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "critic_terminal": {"type": "string", "minLength": 1},
    "lane_classifier_terminal": {"type": ["string", "null"]},
    "decision_event_ids": {"type": "array", "items": {"type": "string"}},
    "next": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_mutation", "experiment_execution", "provider_api_rpc_wss_calls"],
      "properties": {
        "git_mutation": {"const": 0},
        "experiment_execution": {"const": 0},
        "provider_api_rpc_wss_calls": {"const": 0}
      }
    },
    "no_git_fence_receipt": {"type": "object"},
    "created_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "session_started_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "next_action_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "next_action_type": {
      "enum": [
        "WAIT_FOR_NEW_EVIDENCE",
        "FORWARD_DATA_OPTION_READY",
        "CAPABILITY_OPTION_READY"
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidate_count",
        "known_feature_reference_count",
        "known_capability_reference_count",
        "candidate_with_unresolved_requirement_count",
        "unresolved_requirement_count",
        "unique_structural_signature_count",
        "structural_repetition_count",
        "structural_repetition_ratio",
        "critic_terminal",
        "selected_candidate_present",
        "no_worthy_hypothesis"
      ],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "known_feature_reference_count": {"type": "integer", "minimum": 0},
        "known_capability_reference_count": {"type": "integer", "minimum": 0},
        "candidate_with_unresolved_requirement_count": {"type": "integer", "minimum": 0},
        "unresolved_requirement_count": {"type": "integer", "minimum": 0},
        "candidate_with_pit_ready_dependency_count": {"type": "integer", "minimum": 0},
        "candidate_with_historical_only_dependency_count": {"type": "integer", "minimum": 0},
        "candidate_with_forward_only_dependency_count": {"type": "integer", "minimum": 0},
        "candidate_with_missing_dependency_count": {"type": "integer", "minimum": 0},
        "unique_structural_signature_count": {"type": "integer", "minimum": 0},
        "structural_repetition_count": {"type": "integer", "minimum": 0},
        "structural_repetition_ratio": {"type": "number", "minimum": 0},
        "unique_actor_counterparty_count": {"type": "integer", "minimum": 0},
        "unique_mechanism_count": {"type": "integer", "minimum": 0},
        "unique_state_transition_count": {"type": "integer", "minimum": 0},
        "unique_primary_x_family_count": {"type": "integer", "minimum": 0},
        "unique_horizon_notional_count": {"type": "integer", "minimum": 0},
        "candidate_with_known_prior_ref_count": {"type": "integer", "minimum": 0},
        "closed_or_suppressed_collision_count": {"type": "integer", "minimum": 0},
        "critic_terminal": {"type": ["string", "null"]},
        "selected_candidate_present": {"type": "boolean"},
        "no_worthy_hypothesis": {"type": "boolean"},
        "lane_classifier_terminal": {"type": ["string", "null"]},
        "next_action_type_if_any": {"type": ["string", "null"]},
        "context_packet_bytes": {"type": "integer", "minimum": 0},
        "draft_schema_repair_used": {"type": "boolean"},
        "resume_or_replay": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"critic_terminal": {"const": "NO_WORTHY_HYPOTHESIS"}},
        "required": ["critic_terminal"]
      },
      "then": {
        "required": ["critic_launched", "forge_context_packet_sha256"],
        "properties": {
          "selected_candidate_id": {"type": "null"},
          "critic_input_packet_sha256": {"type": "null"},
          "critic_result_sha256": {"type": "null"},
          "critic_launched": {"const": false},
          "forge_context_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "else": {
        "properties": {
          "selected_candidate_id": {
            "type": "string",
            "pattern": "^HFIC-CAND-[0-9A-F]{12,64}$"
          },
          "critic_input_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "critic_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  ]
}
