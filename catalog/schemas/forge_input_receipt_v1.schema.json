{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/forge_input_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "owner_class",
    "active_evidence_set",
    "historical_calibration",
    "representation_input_scope",
    "experiment_data_scope",
    "visibility",
    "representations",
    "packet",
    "forge_runnable",
    "blocking_reason_codes",
    "writes",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "smial.forge-input-receipt"},
    "schema_version": {"const": "1.0"},
    "owner_class": {
      "enum": ["FORGE_INPUT_READY", "INPUT_NOT_READY", "OBSERVABILITY_BLOCKED"]
    },
    "active_evidence_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "current_dataset_manifest_id",
        "visible_cohort_ids",
        "corpus_version",
        "evidence_set_sha256"
      ],
      "properties": {
        "scope": {"const": "ACTIVE_EVIDENCE_SET"},
        "current_dataset_manifest_id": {"type": ["string", "null"]},
        "visible_cohort_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "corpus_version": {"type": ["integer", "null"]},
        "evidence_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "historical_calibration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "calibration_id",
          "cohort_scope",
          "eligibility_scope",
          "receipt_sha256",
          "router_decision",
          "integrity"
        ],
        "properties": {
          "scope": {"const": "HISTORICAL_CALIBRATION"},
          "calibration_id": {"type": "string"},
          "cohort_scope": {"type": "string"},
          "eligibility_scope": {"type": "string"},
          "receipt_sha256": {"type": "string"},
          "router_decision": {"type": ["string", "null"]},
          "integrity": {"enum": ["PASS", "INVALID", "ABSENT"]}
        }
      }
    },
    "representation_input_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status"],
      "properties": {
        "scope": {"const": "REPRESENTATION_INPUT_SCOPE"},
        "status": {"type": "string"}
      }
    },
    "experiment_data_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status"],
      "properties": {
        "scope": {"const": "EXPERIMENT_DATA_SCOPE"},
        "status": {"const": "NOT_STARTED"}
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_binding",
        "lineage",
        "pit_semantics",
        "missingness_visible",
        "prior_memory",
        "feature_grounding",
        "packet_vision",
        "material_truncation"
      ],
      "properties": {
        "corpus_binding": {"enum": ["PASS", "FAIL"]},
        "lineage": {"enum": ["PASS", "FAIL"]},
        "pit_semantics": {"enum": ["PASS", "FAIL", "NOT_EVALUATED"]},
        "missingness_visible": {"enum": ["PASS", "FAIL", "NOT_EVALUATED"]},
        "prior_memory": {"enum": ["PASS", "FAIL"]},
        "feature_grounding": {"enum": ["PASS", "FAIL"]},
        "packet_vision": {"enum": ["PASS", "FAIL"]},
        "material_truncation": {"type": "boolean"}
      }
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representation_id", "status"],
        "properties": {
          "representation_id": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_corpus_in_packet",
        "live_corpus_protected",
        "truncated",
        "bounded_dataset_count",
        "selection_policy"
      ],
      "properties": {
        "live_corpus_in_packet": {"type": "boolean"},
        "live_corpus_protected": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "bounded_dataset_count": {"type": "integer", "minimum": 0},
        "selection_policy": {"type": "string"}
      }
    },
    "live_corpus": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "evidence_surface_mode": {"type": ["string", "null"]},
    "forge_runnable": {"type": "boolean"},
    "blocking_reason_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_store", "forge_context", "session"],
      "properties": {
        "research_store": {"const": 0},
        "forge_context": {"const": 0},
        "session": {"const": 0}
      }
    },
    "data_root_instance_fingerprint_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
