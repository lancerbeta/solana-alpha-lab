{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/hfic_scientific_discovery_prospects_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "portfolio_id",
    "as_of",
    "governed_by",
    "authority",
    "activation_policy",
    "records"
  ],
  "properties": {
    "schema": {"const": "smial.hfic-scientific-discovery-prospect-portfolio"},
    "schema_version": {"const": "1.0"},
    "portfolio_id": {"const": "HFIC-SCIENTIFIC-DISCOVERY-PROSPECT-PORTFOLIO-001"},
    "as_of": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "governed_by": {"const": "ARCH-INTENT-006"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_read",
        "credential_read",
        "git_mutation",
        "rdp_mutation",
        "experiment_execution",
        "holdout_consumption",
        "cash_spend",
        "wallet_signer_transaction",
        "roadmap_activation",
        "next_hypothesis_selection"
      ],
      "properties": {
        "provider_read": {"const": false},
        "credential_read": {"const": false},
        "git_mutation": {"const": false},
        "rdp_mutation": {"const": false},
        "experiment_execution": {"const": false},
        "holdout_consumption": {"const": false},
        "cash_spend": {"const": false},
        "wallet_signer_transaction": {"const": false},
        "roadmap_activation": {"const": false},
        "next_hypothesis_selection": {"const": false}
      }
    },
    "activation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_forge_visibility",
        "max_records_per_query",
        "allowed_triggers",
        "measured_trigger_min_sessions",
        "duplicate_or_reopen_share_gt",
        "preparatory_loop_share_gt",
        "suppress_while_scientific_spend_pending_terminal",
        "execution_authority"
      ],
      "properties": {
        "default_forge_visibility": {"const": "HIDDEN"},
        "max_records_per_query": {"const": 3},
        "allowed_triggers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "enum": [
              "OWNER_DISCOVERY_REFRAME",
              "POST_NO_WORTHY_REVIEW",
              "MEASURED_DUPLICATE_COLLAPSE",
              "MEASURED_PREPARATORY_LOOP"
            ]
          }
        },
        "measured_trigger_min_sessions": {"const": 5},
        "duplicate_or_reopen_share_gt": {"const": 0.2},
        "preparatory_loop_share_gt": {"const": 0.4},
        "suppress_while_scientific_spend_pending_terminal": {"const": true},
        "execution_authority": {"const": "NONE"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {"$ref": "#/$defs/prospect"}
    }
  },
  "$defs": {
    "prospect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prospect_id",
        "rank",
        "title",
        "donor_domains",
        "problem",
        "capability",
        "disposition",
        "implementation_state",
        "current_project_fit",
        "expected_process_impact",
        "durable_edge",
        "effort_class",
        "activation_triggers",
        "prerequisites",
        "named_consumers",
        "minimal_first_atom",
        "satisfied_by",
        "residual_gap",
        "success_signal",
        "kill_or_defer_if",
        "non_goals",
        "source_refs",
        "reassess_when"
      ],
      "properties": {
        "prospect_id": {"type": "string", "pattern": "^HFIC-PROSPECT-[0-9]{3}$"},
        "rank": {"type": "integer", "minimum": 1, "maximum": 23},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "donor_domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "problem": {"type": "string", "minLength": 1, "maxLength": 2000},
        "capability": {"type": "string", "minLength": 1, "maxLength": 2000},
        "disposition": {
          "enum": [
            "ADOPT_NOW",
            "WATCH_TRIGGERED_ONLY",
            "PREREQUISITE_BLOCKED",
            "DEFERRED_CURRENT_HORIZON",
            "REJECTED_CURRENT_HORIZON"
          ]
        },
        "implementation_state": {
          "enum": ["NOT_IMPLEMENTED", "PARTIAL", "SATISFIED_CURRENT_SCOPE"]
        },
        "current_project_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "expected_process_impact": {"type": "integer", "minimum": 1, "maximum": 5},
        "durable_edge": {"type": "integer", "minimum": 1, "maximum": 5},
        "effort_class": {"enum": ["XS", "S", "M", "L", "XL"]},
        "activation_triggers": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "named_consumers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "minimal_first_atom": {"type": "string", "minLength": 1, "maxLength": 200},
        "satisfied_by": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "residual_gap": {"type": "string", "minLength": 1, "maxLength": 2000},
        "success_signal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "kill_or_defer_if": {"type": "string", "minLength": 1, "maxLength": 2000},
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(https://[^ ]+|docs/[^ ]+)$"
          }
        },
        "reassess_when": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
