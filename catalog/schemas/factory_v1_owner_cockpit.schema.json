{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/factory_v1_owner_cockpit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "contract_id",
    "atom_id",
    "as_of",
    "mode",
    "implementation",
    "visible_nav",
    "hidden_nav",
    "packet_fields",
    "attention_item_fields",
    "health",
    "authority"
  ],
  "properties": {
    "schema": {"const": "smial.factory-v1-owner-cockpit"},
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "FACTORY-V1-OWNER-COCKPIT-001"},
    "atom_id": {"const": "OWNER_OPERATIONS_COCKPIT_V1"},
    "as_of": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "mode": {"const": "DIRECT_CURSOR_DELIVERY"},
    "implementation": {"const": "WORKBENCH_WRAP_NO_NEW_UI_PACKAGE"},
    "visible_nav": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["HOME", "RESEARCH", "OPERATIONS", "ECONOMICS", "SYSTEM"]}
    },
    "hidden_nav": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["MARKET"]}
    },
    "packet_fields": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "QUESTION",
          "ESTIMAND",
          "POPULATION",
          "DATA",
          "RESULT",
          "UNCERTAINTY",
          "ROBUSTNESS",
          "FAILURE",
          "DECISION",
          "NEXT"
        ]
      }
    },
    "attention_item_fields": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["WHY_NOW", "IMPACT", "EVIDENCE", "NEXT_SAFE_ACTION"]}
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_alive_alone_is_not_healthy",
        "operational_ready_claim_forbidden",
        "empty_enterprise_screens_forbidden"
      ],
      "properties": {
        "process_alive_alone_is_not_healthy": {"const": true},
        "operational_ready_claim_forbidden": {"const": true},
        "empty_enterprise_screens_forbidden": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_calls",
        "credentials",
        "deployment",
        "cash_spend",
        "wallet_signer_transaction",
        "ui_package_adoption"
      ],
      "properties": {
        "provider_calls": {"const": false},
        "credentials": {"const": false},
        "deployment": {"const": false},
        "cash_spend": {"const": false},
        "wallet_signer_transaction": {"const": false},
        "ui_package_adoption": {"const": false}
      }
    }
  }
}
