{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lancerbeta.github.io/solana-alpha-lab/schemas/provider_route_capability_registry_v11.schema.json",
  "title": "SMIAL provider route capability registry v11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "registry_id",
    "as_of",
    "supersedes",
    "update_policy",
    "routes",
    "non_claims"
  ],
  "properties": {
    "schema": {
      "const": "smial.provider-route-capability-registry"
    },
    "schema_version": {
      "const": "11.0"
    },
    "registry_id": {
      "const": "PROVIDER-ROUTE-CAPABILITY-REGISTRY-011"
    },
    "as_of": {
      "const": "2026-10-06"
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "path",
        "sha256",
        "preserved_route_semantic_sha256",
        "transitioned_route_semantic_sha256"
      ],
      "properties": {
        "registry_id": {
          "const": "PROVIDER-ROUTE-CAPABILITY-REGISTRY-010"
        },
        "path": {
          "const": "configs/provider_route_capability_registry_v10.yaml"
        },
        "sha256": {
          "const": "b56dbc70819d52281cd5cd62e86c5b759ef3c3dd3bff8787faf2a605b496c2dc"
        },
        "preserved_route_semantic_sha256": {
          "type": "object",
          "minProperties": 12,
          "maxProperties": 12,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "transitioned_route_semantic_sha256": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "update_policy": {
      "type": "object"
    },
    "routes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "provider",
          "endpoint_family",
          "network",
          "access_class",
          "operation",
          "protocol",
          "runtime",
          "preflight",
          "last_success",
          "last_observation",
          "known_failures",
          "execution_policy",
          "evidence",
          "non_claims"
        ],
        "additionalProperties": true
      }
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_reliability",
        "data_completeness",
        "market_activity",
        "task30_trial",
        "alpha",
        "numeric_netreturn"
      ],
      "properties": {
        "provider_reliability": {
          "const": false
        },
        "data_completeness": {
          "const": false
        },
        "market_activity": {
          "const": false
        },
        "task30_trial": {
          "const": false
        },
        "alpha": {
          "const": false
        },
        "numeric_netreturn": {
          "const": false
        }
      }
    }
  }
}
