{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smial:task26c:owned-execution-canary-readiness:1.0",
  "title": "TASK-26C owned execution canary readiness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "task_id",
    "atom_id",
    "as_of",
    "status",
    "input_bindings",
    "decision",
    "authority",
    "role_boundaries",
    "future_witness_contract",
    "reconciliation_before_retry",
    "allowlist_policy",
    "owner_approval_packet",
    "health_blocks",
