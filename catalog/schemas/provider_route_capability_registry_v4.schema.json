{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lancerbeta.github.io/solana-alpha-lab/schemas/provider_route_capability_registry_v4.schema.json",
  "title": "SMIAL provider route capability registry v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "registry_id", "as_of", "supersedes", "update_policy", "routes", "non_claims"],
  "properties": {
    "schema": {"const": "smial.provider-route-capability-registry"},
    "schema_version": {"const": "4.0"},
    "registry_id": {"const": "PROVIDER-ROUTE-CAPABILITY-REGISTRY-004"},
    "as_of": {"const": "2026-08-14"},
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "path", "sha256", "preserved_route_semantic_sha256"],
      "properties": {
        "registry_id": {"const": "PROVIDER-ROUTE-CAPABILITY-REGISTRY-003"},
        "path": {"const": "configs/provider_route_capability_registry_v3.yaml"},
        "sha256": {"const": "dfab094593c061fc2dcbe344b2e7977942927f833c2d2a83e50aa5a3e27cd95e"},
        "preserved_route_semantic_sha256": {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 4,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "update_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_receipt_required", "preserve_receipt_history", "separate_last_success", "registry_gap_is_unavailability", "automatic_routing", "authority_granted"],
      "properties": {
        "observed_receipt_required": {"const": true},
        "preserve_receipt_history": {"const": true},
        "separate_last_success": {"const": true},
        "registry_gap_is_unavailability": {"const": false},
        "automatic_routing": {"const": false},
        "authority_granted": {"const": false}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["route_id", "provider", "endpoint_family", "network", "access_class", "operation", "protocol", "runtime", "preflight", "last_success", "last_observation", "known_failures", "execution_policy", "evidence", "non_claims"],
        "additionalProperties": true
      }
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_reliability", "data_completeness", "market_activity", "task30_trial", "alpha", "numeric_netreturn"],
      "properties": {
        "provider_reliability": {"const": false},
        "data_completeness": {"const": false},
        "market_activity": {"const": false},
        "task30_trial": {"const": false},
        "alpha": {"const": false},
        "numeric_netreturn": {"const": false}
      }
    }
  }
}
