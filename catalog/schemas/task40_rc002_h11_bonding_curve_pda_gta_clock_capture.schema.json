    "clock_definitions": {"type": "object"},
    "capture_protocol": {"type": "object"},
    "rc001_freeze": {"type": "object"},
    "holdout_guard": {"type": "object"},
    "pda_subset": {"type": "object"},
    "adopted_route": {"type": "object"},
    "request": {"type": "object"},
    "runtime_limits": {"type": "object"},
    "execution_controls": {"type": "object"},
