{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://catalog/schemas/promotion_handoff_manifest_v1.schema.json",
  "title": "SMIAL promotion handoff manifest v1.0",
  "description": "Decision-time machine inputs frozen inside a new scientific PROMOTE. Additive to evidence_snapshot_sha256; does not redefine it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "decision_event_id",
    "decision_effective_at",
    "experiment_id",
    "hypothesis_version_id",
    "experiment_spec_source_kind",
    "experiment_spec_source_value",
    "experiment_spec_sha256",
    "evidence_snapshot_sha256",
    "direct_evidence",
    "obligations",
    "population_ref",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {"const": "smial.promotion-handoff-manifest"},
    "schema_version": {"const": "1.0"},
    "decision_event_id": {"type": "string", "minLength": 8, "maxLength": 160},
    "decision_effective_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "experiment_id": {"type": "string", "minLength": 3, "maxLength": 120},
    "hypothesis_version_id": {"type": "string", "minLength": 3, "maxLength": 120},
    "experiment_spec_source_kind": {"const": "git_path"},
    "experiment_spec_source_value": {"type": "string", "minLength": 8, "maxLength": 240},
    "experiment_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "direct_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "payload_sha256"],
        "properties": {
          "record_id": {"type": "string", "minLength": 3, "maxLength": 160},
          "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status"],
        "properties": {
          "code": {"type": "string", "minLength": 2, "maxLength": 64},
          "status": {
            "enum": ["PRESENT", "MISSING", "UNKNOWN", "CONFLICT", "NOT_APPLICABLE"]
          }
        }
      }
    },
    "promotion_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "population_ref": {"type": "string", "minLength": 3, "maxLength": 120},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
