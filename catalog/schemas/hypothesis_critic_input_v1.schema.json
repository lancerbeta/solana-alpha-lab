{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/hypothesis_critic_input_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_schema",
    "packet_version",
    "generator_prompt_version",
    "generated_at",
    "live_git_head",
    "research_memory_as_of",
    "owner_focus",
    "authority",
    "holdouts_not_touched",
    "truth_roots_used",
    "prior_work_queries",
    "selected_candidate",
    "provisional_lane",
    "provisional_execution_unit",
    "strongest_rejected_alternative",
    "known_unknowns",
    "non_claims"
  ],
  "properties": {
    "packet_schema": {"const": "smial.hypothesis-critic-input"},
    "packet_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]},
    "generator_prompt_version": {"enum": ["HFIC-V1.0", "HFIC-V1.1", "HFIC-V1.2"]},
    "generated_at": {"type": "string", "minLength": 1},
    "live_git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "research_memory_as_of": {"type": "string", "minLength": 1},
    "owner_focus": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_mutation", "experiment_execution", "provider_api_rpc_wss_calls"],
      "properties": {
        "git_mutation": {"const": 0},
        "experiment_execution": {"const": 0},
        "provider_api_rpc_wss_calls": {"const": 0}
      }
    },
    "holdouts_not_touched": {"type": "array", "items": {"type": "string"}},
    "truth_roots_used": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "prior_work_queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selected_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "claim",
        "nearest_prior_and_difference",
        "actor_counterparty",
        "mechanism",
        "why_not_arbitraged",
        "population",
        "decision_timestamp",
        "primary_x",
        "primary_y",
        "horizon_notional",
        "disconfirming_prediction",
        "negative_control",
        "alternative_world",
        "confounders",
        "pit_leakage_survivorship_risks",
        "execution_capacity_risks",
        "available_data_bindings",
        "missing_or_forward_only_data",
        "proposed_method",
        "cheapest_falsifier",
        "pass_fail_inconclusive_semantics",
        "decision_unlocked"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "nearest_prior_and_difference": {"type": "string", "minLength": 1},
        "actor_counterparty": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "why_not_arbitraged": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "decision_timestamp": {"type": "string", "minLength": 1},
        "primary_x": {"type": "string", "minLength": 1},
        "primary_y": {"type": "string", "minLength": 1},
        "horizon_notional": {"type": "string", "minLength": 1},
        "disconfirming_prediction": {"type": "string", "minLength": 1},
        "negative_control": {"type": "string", "minLength": 1},
        "alternative_world": {"type": "string", "minLength": 1},
        "confounders": {"type": "array", "items": {"type": "string"}},
        "pit_leakage_survivorship_risks": {"type": "array", "items": {"type": "string"}},
        "execution_capacity_risks": {"type": "array", "items": {"type": "string"}},
        "available_data_bindings": {"type": "array", "items": {"type": "string"}},
        "missing_or_forward_only_data": {"type": "array", "items": {"type": "string"}},
        "proposed_method": {"type": "string", "minLength": 1},
        "cheapest_falsifier": {"type": "string", "minLength": 1},
        "pass_fail_inconclusive_semantics": {"type": "string", "minLength": 1},
        "decision_unlocked": {"type": "string", "minLength": 1},
        "estimand": {"type": "string"},
        "state_transition": {"type": ["string", "null"]},
        "required_feature_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_capability_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unresolved_requirements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "grounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_packet_sha256",
            "feature_bindings",
            "capability_bindings",
            "unresolved_requirements",
            "terminal"
          ],
          "properties": {
            "context_packet_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "feature_bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "feature_id",
                  "availability_class",
                  "available_to_strategy_semantics"
                ],
                "properties": {
                  "feature_id": {"type": "string", "minLength": 1},
                  "availability_class": {"type": "string", "minLength": 1},
                  "available_to_strategy_semantics": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value_status": {"type": "string", "minLength": 1}
                }
              }
            },
            "capability_bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capability_id",
                  "accepted",
                  "authority_granted"
                ],
                "properties": {
                  "capability_id": {"type": "string", "minLength": 1},
                  "accepted": {"type": "boolean"},
                  "authority_granted": {"type": "boolean"}
                }
              }
            },
            "unresolved_requirements": {
              "type": "array",
              "items": {"type": "string"}
            },
            "terminal": {
              "enum": ["GROUNDED", "GROUNDED_WITH_GAPS"]
            }
          }
        }
      }
    },
    "provisional_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "required_capability_ids",
        "required_query_recipe_ids",
        "required_data_bindings",
        "exact_gap"
      ],
      "properties": {
        "value": {
          "enum": [
            "FAST_LANE_CANDIDATE",
            "CHANGE_LANE_CANDIDATE",
            "DATA_OPTION_CANDIDATE",
            "PROMOTION_LANE_CANDIDATE",
            "DENY_CANDIDATE"
          ]
        },
        "required_capability_ids": {"type": "array", "items": {"type": "string"}},
        "required_query_recipe_ids": {"type": "array", "items": {"type": "string"}},
        "required_data_bindings": {"type": "array", "items": {"type": "string"}},
        "exact_gap": {"type": "string", "minLength": 1}
      }
    },
    "provisional_execution_unit": {"type": "string", "minLength": 1},
    "strongest_rejected_alternative": {"type": "string", "minLength": 1},
    "known_unknowns": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "session_id": {
      "type": "string",
      "pattern": "^HFIC-SESS-[A-Z0-9]+$"
    },
    "prior_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "complete",
        "eligible_count",
        "emitted_count",
        "bytes",
        "snapshot_sha256",
        "store_inventory_digest",
        "max_records",
        "max_bytes",
        "capsules"
      ],
      "properties": {
        "schema": {"const": "smial.hfic-prior-memory-snapshot"},
        "schema_version": {"const": "1.0"},
        "complete": {"const": true},
        "eligible_count": {"type": "integer", "minimum": 0},
        "emitted_count": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "store_inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "max_records": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "capsules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis_version_id",
              "memory_status",
              "claim",
              "mechanism",
              "actor_counterparty",
              "population",
              "decision_timestamp",
              "primary_x_family",
              "primary_y",
              "horizon_notional",
              "negative_control",
              "cheapest_falsifier"
            ],
            "properties": {
              "hypothesis_version_id": {"type": "string", "minLength": 1},
              "session_id": {"type": ["string", "null"]},
              "hfic_protocol": {"type": ["string", "null"]},
              "definition_sha256": {"type": ["string", "null"]},
              "memory_status": {
                "enum": [
                  "HARD_CLOSE",
                  "PARK",
                  "NOT_SELECTED_IN_SESSION",
                  "AMBIGUOUS",
                  "HISTORICAL"
                ]
              },
              "decision_kind": {"type": ["string", "null"]},
              "reason_code": {"type": ["string", "null"]},
              "claim": {"type": ["string", "null"]},
              "mechanism": {"type": ["string", "null"]},
              "actor_counterparty": {"type": ["string", "null"]},
              "population": {"type": ["string", "null"]},
              "decision_timestamp": {"type": ["string", "null"]},
              "primary_x_family": {"type": ["string", "null"]},
              "primary_y": {"type": ["string", "null"]},
              "horizon_notional": {"type": ["string", "null"]},
              "negative_control": {"type": ["string", "null"]},
              "cheapest_falsifier": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "packet_version": {"enum": ["1.1", "1.2", "1.3", "1.4"]}
        },
        "required": ["packet_version"]
      },
      "then": {
        "required": ["session_id"]
      }
    },
    {
      "if": {
        "properties": {
          "packet_version": {"enum": ["1.3", "1.4"]}
        },
        "required": ["packet_version"]
      },
      "then": {
        "required": ["prior_memory"]
      }
    },
    {
      "if": {
        "properties": {
          "packet_version": {"const": "1.4"}
        },
        "required": ["packet_version"]
      },
      "then": {
        "properties": {
          "selected_candidate": {
            "required": [
              "candidate_id",
              "claim",
              "nearest_prior_and_difference",
              "actor_counterparty",
              "mechanism",
              "why_not_arbitraged",
              "population",
              "decision_timestamp",
              "primary_x",
              "primary_y",
              "horizon_notional",
              "disconfirming_prediction",
              "negative_control",
              "alternative_world",
              "confounders",
              "pit_leakage_survivorship_risks",
              "execution_capacity_risks",
              "available_data_bindings",
              "missing_or_forward_only_data",
              "proposed_method",
              "cheapest_falsifier",
              "pass_fail_inconclusive_semantics",
              "decision_unlocked",
              "estimand",
              "state_transition",
              "required_feature_ids",
              "required_capability_ids",
              "unresolved_requirements",
              "grounding"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "packet_version": {"enum": ["1.0", "1.1"]}
        },
        "required": ["packet_version"]
      },
      "then": {
        "properties": {"prior_memory": false}
      }
    }
  ]
}
