{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/factory_v1_product_kernel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "contract_id",
    "atom_id",
    "as_of",
    "mode",
    "implementation",
    "golden_experiment_id",
    "allowlisted_capabilities",
    "operational_store",
    "ui_gate",
    "authority"
  ],
  "properties": {
    "schema": {"const": "smial.factory-v1-product-kernel"},
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "FACTORY-V1-PRODUCT-KERNEL-001"},
    "atom_id": {"const": "FACTORY_V1_PRODUCT_KERNEL_LOCAL_VERTICAL_SLICE_V1"},
    "as_of": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "mode": {"const": "DIRECT_CURSOR_DELIVERY"},
    "implementation": {"const": "LOCAL_VERTICAL_SLICE"},
    "golden_experiment_id": {"type": "string", "minLength": 8},
    "allowlisted_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CAP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"}
    },
    "operational_store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_path", "owns_scientific_truth"],
      "properties": {
        "kind": {"const": "SQLITE"},
        "relative_path": {"type": "string", "minLength": 8},
        "owns_scientific_truth": {"const": false}
      }
    },
    "ui_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "selected", "package_adoption"],
      "properties": {
        "verdict": {"enum": ["ADOPT", "WRAP", "FORK", "BUILD"]},
        "selected": {"type": "string", "minLength": 3},
        "package_adoption": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_calls",
        "credentials",
        "deployment",
        "cash_spend",
        "wallet_signer_transaction"
      ],
      "properties": {
        "provider_calls": {"const": false},
        "credentials": {"const": false},
        "deployment": {"const": false},
        "cash_spend": {"const": false},
        "wallet_signer_transaction": {"const": false}
      }
    }
  }
}
