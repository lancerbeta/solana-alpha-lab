{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/forge_research_universe_policy_v1.schema.json",
  "title": "Forge research-universe profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["holder_field_id", "liquidity_field_id", "min_holders", "min_liquidity_usd", "rule"],
  "properties": {
    "holder_field_id": {"const": "FIELD-HOLDER-COUNT-001"},
    "liquidity_field_id": {"const": "FIELD-LIQUIDITY-USD-001"},
    "min_holders": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "min_liquidity_usd": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "rule": {"const": "ALL_OF_AT_DECISION_TIME"}
  }
}
