{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/experiment_spec_v1_4.schema.json",
  "title": "SMIAL ExperimentSpec v1.4 native episode reuse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "experiment_id",
    "hypothesis_version",
    "question",
    "estimand",
    "population",
    "data_requirements",
    "capabilities",
    "falsifier",
    "method",
    "parameters",
    "evidence_budget",
    "holdout_policy",
    "terminal_outcomes",
    "data_bindings",
    "query_recipe_ids",
    "capability_id",
    "parameter_schema_asset_id",
    "as_of",
    "availability_cutoff",
    "what_changed",
    "observation_request",
    "required_outcomes"
  ],
  "properties": {
    "schema": {
      "const": "smial.experiment-spec"
    },
    "schema_version": {
      "const": "1.4"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "hypothesis_version": {
      "type": "string",
      "pattern": "^HYP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "question": {
      "type": "string",
      "minLength": 12,
      "maxLength": 500
    },
    "estimand": {
      "type": "string",
      "minLength": 8,
      "maxLength": 240
    },
    "population": {
      "const": "OPPORTUNITY_EPISODES"
    },
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "kind",
          "path"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "GIT_CANONICAL_RECEIPT",
              "GIT_CANONICAL_ACCEPTANCE",
              "CATALOG_ASSET",
              "CAPTURE_POLICY",
              "PROVIDER_BOUNDED_CAPTURE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "GIT_CANONICAL_RECEIPT",
                    "GIT_CANONICAL_ACCEPTANCE",
                    "CATALOG_ASSET",
                    "CAPTURE_POLICY"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "sha256"
              ]
            }
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability_id"
      }
    },
    "required_feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FEAT-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
      }
    },
    "falsifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 240
    },
    "method": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "parameters": {
      "type": "object",
      "required": [
        "temporal_recipe"
      ],
      "properties": {
        "temporal_recipe": {
          "type": "object",
          "required": [
            "spec",
            "scientific_identity",
            "frozen_input",
            "research_scope_evidence",
            "universe_policy"
          ]
        }
      }
    },
    "evidence_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_api_rpc_wss_calls"
      ],
      "properties": {
        "provider_api_rpc_wss_calls": {
          "const": 0
        }
      }
    },
    "holdout_policy": {
      "type": "string",
      "minLength": 8,
      "maxLength": 240
    },
    "terminal_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      }
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "source_kind",
          "stable_id",
          "expected_content_sha256_or_dataset_fingerprint"
        ],
        "properties": {
          "binding_id": {
            "$ref": "#/$defs/stable_id"
          },
          "source_kind": {
            "enum": [
              "CATALOG_ASSET",
              "DATASET_MANIFEST",
              "RESEARCH_ARTIFACT"
            ]
          },
          "stable_id": {
            "type": "string"
          },
          "expected_content_sha256_or_dataset_fingerprint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,255}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_kind": {
                  "const": "DATASET_MANIFEST"
                }
              },
              "required": [
                "source_kind"
              ]
            },
            "then": {
              "properties": {
                "stable_id": {
                  "$ref": "#/$defs/dataset_manifest_id"
                }
              }
            },
            "else": {
              "properties": {
                "stable_id": {
                  "$ref": "#/$defs/stable_id"
                }
              }
            }
          }
        ]
      }
    },
    "query_recipe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stable_id"
      }
    },
    "capability_id": {
      "const": "CAP-HFIC-TEMPORAL-FIXED-TIME-PROXY-001"
    },
    "parameter_schema_asset_id": {
      "$ref": "#/$defs/stable_id"
    },
    "as_of": {
      "$ref": "#/$defs/timestamp"
    },
    "availability_cutoff": {
      "$ref": "#/$defs/timestamp"
    },
    "what_changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
      }
    },
    "observation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_mode",
        "requested_evidence_role"
      ],
      "properties": {
        "collection_mode": {
          "const": "REUSE_ONLY"
        },
        "requested_evidence_role": {
          "const": "EXPLORATORY_REUSE"
        }
      }
    },
    "required_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point_id",
          "field_ids",
          "role"
        ],
        "properties": {
          "point_id": {
            "type": "string",
            "pattern": "^E(?:0|[1-9][0-9]{0,6})$"
          },
          "field_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/field_id"
            }
          },
          "role": {
            "enum": [
              "PRIMARY",
              "AUXILIARY"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "dataset_manifest_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/stable_id"
        },
        {
          "type": "string",
          "pattern": "^dataset-[0-9a-f]{64}$"
        }
      ]
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "field_id": {
      "type": "string",
      "pattern": "^FIELD-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    }
  }
}
