{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lancerbeta.github.io/solana-alpha-lab/schemas/provider_route_capability_registry_v7.schema.json",
  "title": "SMIAL provider route capability registry v7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "registry_id", "as_of", "supersedes", "update_policy", "routes", "non_claims"],
  "properties": {
    "schema": {"const": "smial.provider-route-capability-registry"},
    "schema_version": {"const": "7.0"},
    "registry_id": {"const": "PROVIDER-ROUTE-CAPABILITY-REGISTRY-007"},
    "as_of": {"const": "2026-08-17"},
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "path", "sha256", "preserved_route_semantic_sha256"],
      "properties": {
        "registry_id": {"const": "PROVIDER-ROUTE-CAPABILITY-REGISTRY-006"},
        "path": {"const": "configs/provider_route_capability_registry_v6.yaml"},
        "sha256": {"const": "b9642b77c300c81aedebc4aa464284fe244a7553bb3a37bdbb344d68594df580"},
        "preserved_route_semantic_sha256": {
          "type": "object",
          "minProperties": 6,
          "maxProperties": 6,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "update_policy": {"type": "object"},
    "routes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["route_id", "provider", "endpoint_family", "network", "access_class", "operation", "protocol", "runtime", "preflight", "last_success", "last_observation", "known_failures", "execution_policy", "evidence", "non_claims"],
        "additionalProperties": true
      }
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_reliability", "data_completeness", "market_activity", "task30_trial", "alpha", "numeric_netreturn"],
      "properties": {
        "provider_reliability": {"const": false},
        "data_completeness": {"const": false},
        "market_activity": {"const": false},
        "task30_trial": {"const": false},
        "alpha": {"const": false},
        "numeric_netreturn": {"const": false}
      }
    }
  }
}
