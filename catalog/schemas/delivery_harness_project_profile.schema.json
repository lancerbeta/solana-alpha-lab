{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/delivery_harness_project_profile.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "profile_id", "harness_id", "mode", "repository", "bindings", "working_memory", "context_budgets", "validation", "authority"],
  "properties": {
    "schema": {"const": "smial.delivery-harness-project-profile"}, "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,127}$"}, "harness_id": {"const": "DELIVERY_HARNESS_V1"},
    "mode": {"enum": ["BOUND_PROJECT", "PORTABLE_PROJECT"]},
    "repository": {"type": "object", "additionalProperties": false, "required": ["name", "default_branch"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "default_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["catalog_manifest", "owner_attention_policy", "context_map", "domain_policy", "historical_cloud_bundle_registry"], "properties": {"catalog_manifest": {"type": ["string", "null"]}, "owner_attention_policy": {"type": "string"}, "context_map": {"type": "string"}, "domain_policy": {"type": ["string", "null"]}, "historical_cloud_bundle_registry": {"type": ["string", "null"]}}},
    "working_memory": {"type": "object", "additionalProperties": false, "required": ["truth_owner", "task_resolution", "cloud_bundle"], "properties": {"truth_owner": {"const": "GIT"}, "task_resolution": {"const": "EXACT_TASK_CONTRACT"}, "cloud_bundle": {"const": "OWNER_MANAGED_OPTIONAL_EXPORT"}}},
    "context_budgets": {"type": "object", "additionalProperties": false, "required": ["agents_max_bytes", "cursor_always_apply_max_bytes", "ordinary_receipt_max_bytes", "auto_inline_file_max_bytes"], "properties": {"agents_max_bytes": {"const": 12288}, "cursor_always_apply_max_bytes": {"const": 6144}, "ordinary_receipt_max_bytes": {"const": 49152}, "auto_inline_file_max_bytes": {"const": 102400}}},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["github_ci_bound", "primary", "fallback", "credential_scan"],
      "properties": {
        "github_ci_bound": {"type": "boolean"},
        "primary": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/validation_command"}]},
        "fallback": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/validation_command"}]},
        "credential_scan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/standalone_command"}]}
      }
    },
    "authority": {"type": "object", "additionalProperties": false, "required": ["external_system", "signing_or_financial_action", "cash_spend", "cloud_export_mutation"], "properties": {"external_system": {"const": false}, "signing_or_financial_action": {"const": false}, "cash_spend": {"const": false}, "cloud_export_mutation": {"const": false}}},
    "factory_v1_readiness_contract": {"type": ["string", "null"], "pattern": "^configs/factory_v1_operational_readiness_v1\\.yaml$"}
  },
  "$defs": {
    "argv": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "validation_command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "result_owner", "trusted_paths"],
      "properties": {
        "argv": {"$ref": "#/$defs/argv"},
        "result_owner": {"enum": ["FOCUSED_PLUS_EXACT_PR_CI", "FULL_EXACT_HEAD"]},
        "trusted_paths": {"$ref": "#/$defs/argv"}
      }
    },
    "standalone_command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "trusted_paths"],
      "properties": {
        "argv": {"$ref": "#/$defs/argv"},
        "trusted_paths": {"$ref": "#/$defs/argv"}
      }
    }
  }
}
