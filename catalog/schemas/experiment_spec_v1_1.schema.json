{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/experiment_spec_v1_1.schema.json",
  "title": "SMIAL ExperimentSpec v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "experiment_id",
    "hypothesis_version",
    "question",
    "estimand",
    "population",
    "data_requirements",
    "capabilities",
    "falsifier",
    "method",
    "parameters",
    "evidence_budget",
    "holdout_policy",
    "terminal_outcomes",
    "data_bindings",
    "query_recipe_ids",
    "capability_id",
    "parameter_schema_asset_id",
    "as_of",
    "availability_cutoff",
    "what_changed"
  ],
  "properties": {
    "schema": {"const": "smial.experiment-spec"},
    "schema_version": {"const": "1.1"},
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "hypothesis_version": {
      "type": "string",
      "pattern": "^HYP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "question": {"type": "string", "minLength": 12, "maxLength": 500},
    "estimand": {"type": "string", "minLength": 8, "maxLength": 240},
    "population": {"type": "string", "minLength": 8, "maxLength": 240},
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "kind", "path"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 3, "maxLength": 120},
          "kind": {
            "enum": [
              "GIT_CANONICAL_RECEIPT",
              "GIT_CANONICAL_ACCEPTANCE",
              "CATALOG_ASSET",
              "CAPTURE_POLICY",
              "PROVIDER_BOUNDED_CAPTURE"
            ]
          },
          "path": {"type": "string", "minLength": 8, "maxLength": 240},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "GIT_CANONICAL_RECEIPT",
                    "GIT_CANONICAL_ACCEPTANCE",
                    "CATALOG_ASSET",
                    "CAPTURE_POLICY"
                  ]
                }
              },
              "required": ["kind"]
            },
            "then": {"required": ["sha256"]}
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability_id"}
    },
    "required_feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FEAT-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
      }
    },
    "falsifier": {"type": "string", "minLength": 8, "maxLength": 240},
    "method": {"type": "string", "minLength": 3, "maxLength": 80},
    "parameters": {"type": "object"},
    "evidence_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_api_rpc_wss_calls"],
      "properties": {
        "provider_api_rpc_wss_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 62
        }
      }
    },
    "holdout_policy": {"type": "string", "minLength": 8, "maxLength": 240},
    "terminal_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 80}
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "source_kind",
          "stable_id",
          "expected_content_sha256_or_dataset_fingerprint"
        ],
        "properties": {
          "binding_id": {"$ref": "#/$defs/stable_id"},
          "source_kind": {
            "enum": [
              "CATALOG_ASSET",
              "DATASET_MANIFEST",
              "RESEARCH_ARTIFACT"
            ]
          },
          "stable_id": {"$ref": "#/$defs/stable_id"},
          "expected_content_sha256_or_dataset_fingerprint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,255}$"
          }
        }
      }
    },
    "query_recipe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_id"}
    },
    "capability_id": {"$ref": "#/$defs/capability_id"},
    "parameter_schema_asset_id": {"$ref": "#/$defs/stable_id"},
    "as_of": {"$ref": "#/$defs/timestamp"},
    "availability_cutoff": {"$ref": "#/$defs/timestamp"},
    "what_changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
