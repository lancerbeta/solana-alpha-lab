{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smial:catalog:asset-registry:1.0",
  "title": "SMIAL asset registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "as_of",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "record_version",
        "asset_type",
        "purpose",
        "status",
        "origin",
        "as_of",
        "truth_owner",
        "location",
        "integrity",
        "access",
        "relations",
        "consumers",
        "evidence",
        "classification"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "record_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "asset_type": {
          "enum": [
            "repository_snapshot",
            "environment",
            "control_document",
            "configuration",
            "lockfile",
            "script",
            "catalog_root",
            "catalog_registry",
            "schema",
            "decision",
            "evidence"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 12,
          "maxLength": 500
        },
        "status": {
          "enum": [
            "PROPOSED",
            "DECIDED_NOT_IMPLEMENTED",
            "IMPLEMENTED_UNVERIFIED",
            "VALIDATED_ACTIVE",
            "VALIDATED_LOCAL_COMMITTED",
            "INSTALLED_NOT_CONNECTED",
            "DEPRECATED"
          ]
        },
        "origin": {
          "enum": [
            "REPOSITORY",
            "RUNTIME",
            "PROJECT_SOURCE",
            "PRE_GIT",
            "EXTERNAL"
          ]
        },
        "as_of": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "truth_owner": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:TASK-[0-9]{2}|[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+)$"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contains_secrets",
            "contains_raw_data",
            "sensitivity"
          ],
          "properties": {
            "contains_secrets": {
              "const": false
            },
            "contains_raw_data": {
              "const": false
            },
            "sensitivity": {
              "enum": [
                "PUBLIC",
                "INTERNAL_NON_SECRET"
              ]
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "logical_uri"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git_path",
            "git_commit",
            "runtime",
            "logical_only",
            "project_source"
          ]
        },
        "logical_uri": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "repository_path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "git_path"
              }
            }
          },
          "then": {
            "required": [
              "repository_path"
            ]
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sha256",
            "git_commit",
            "runtime_receipt",
            "catalog_commit",
            "none"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "commit_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "tree_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "required": [
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "git_commit"
              }
            }
          },
          "then": {
            "required": [
              "commit_oid",
              "tree_oid"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "runtime_receipt"
              }
            }
          },
          "then": {
            "required": [
              "reference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "catalog_commit"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ]
          }
        }
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "method",
        "network_required",
        "secrets_required"
      ],
      "properties": {
        "mode": {
          "enum": [
            "read_only",
            "task_write",
            "prohibited"
          ]
        },
        "method": {
          "enum": [
            "file",
            "command",
            "runtime_attestation",
            "git_object"
          ]
        },
        "recipe_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "network_required": {
          "type": "boolean"
        },
        "secrets_required": {
          "const": false
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_type",
        "target_asset_id"
      ],
      "properties": {
        "relation_type": {
          "enum": [
            "contains",
            "depends_on",
            "validated_by",
            "evidenced_by",
            "resolves_to",
            "governed_by",
            "consumes",
            "produces"
          ]
        },
        "target_asset_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "reference",
        "result"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "kind": {
          "enum": [
            "runtime_receipt",
            "validator",
            "decision",
            "user_attestation",
            "commit"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "result": {
          "enum": [
            "PASS",
            "PENDING",
            "NOT_TESTABLE"
          ]
        }
      }
    }
  }
}
