{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/hfic_next_epistemic_action_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_schema",
    "packet_version",
    "prompt_version",
    "hfic_protocol",
    "action_id",
    "session_id",
    "evidence_epoch_sha256",
    "focus_key_sha256",
    "search_key_sha256",
    "forge_context_packet_sha256",
    "candidate_ids",
    "source_terminal",
    "generation_mode",
    "created_at",
    "action_type",
    "reason_code",
    "named_consumer",
    "basis_candidate_refs",
    "prospect_ids",
    "evidence_gap",
    "why_now",
    "why_cheaper_option_is_insufficient",
    "action_payload",
    "owner_gate",
    "authority",
    "non_claims"
  ],
  "properties": {
    "packet_schema": {"const": "smial.hfic-next-epistemic-action"},
    "packet_version": {"const": "1.0"},
    "prompt_version": {"const": "HFIC-NEXT-V1.0"},
    "hfic_protocol": {"const": "HFIC-V1.1"},
    "action_id": {"type": "string", "pattern": "^HFIC-NEXT-[0-9A-F]{16}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "evidence_epoch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "focus_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "search_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "forge_context_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {"type": "string", "pattern": "^HFIC-CAND-[0-9A-F]{12,64}$"}
    },
    "source_terminal": {"const": "NO_WORTHY_HYPOTHESIS"},
    "generation_mode": {
      "enum": ["MODEL_VALIDATED", "DETERMINISTIC_SAFE_FALLBACK"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "action_type": {
      "enum": [
        "WAIT_FOR_NEW_EVIDENCE",
        "FORWARD_DATA_OPTION_READY",
        "CAPABILITY_OPTION_READY"
      ]
    },
    "reason_code": {
      "enum": [
        "NO_ADMISSIBLE_UNCONSUMED_EVIDENCE",
        "ONE_BOUNDED_FORWARD_OBSERVATION_JUSTIFIED",
        "ONE_NAMED_CAPABILITY_GAP_BLOCKS_FALSIFIER",
        "ACTIVE_SCIENTIFIC_SPEND_PENDING_TERMINAL",
        "PROSPECT_PREREQUISITES_NOT_MET",
        "EXISTING_TERMINAL_ALREADY_DETERMINES_NEXT",
        "NEXT_ACTION_GENERATION_FALLBACK"
      ]
    },
    "named_consumer": {"type": "string", "minLength": 1, "maxLength": 80},
    "basis_candidate_refs": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "pattern": "^HFIC-CAND-[0-9A-F]{12,64}$"}
    },
    "prospect_ids": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "pattern": "^HFIC-PROSPECT-[0-9]{3}$"}
    },
    "evidence_gap": {"type": "string", "minLength": 1, "maxLength": 2000},
    "why_now": {"type": "string", "minLength": 1, "maxLength": 2000},
    "why_cheaper_option_is_insufficient": {"type": "string", "minLength": 1, "maxLength": 2000},
    "action_payload": {"type": "object"},
    "owner_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "phrase_status"],
      "properties": {
        "required": {"type": "boolean"},
        "phrase_status": {"enum": ["NONE", "PROPOSED_NOT_AUTHORITY"]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_mutation",
        "rdp_mutation_outside_freeze",
        "experiment_execution",
        "provider_api_rpc_wss_calls",
        "credential_reads",
        "cash_spend_usd_cents",
        "wallet_signer_transaction_actions"
      ],
      "properties": {
        "git_mutation": {"const": 0},
        "rdp_mutation_outside_freeze": {"const": 0},
        "experiment_execution": {"const": 0},
        "provider_api_rpc_wss_calls": {"const": 0},
        "credential_reads": {"const": 0},
        "cash_spend_usd_cents": {"const": 0},
        "wallet_signer_transaction_actions": {"const": 0}
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action_type": {"const": "WAIT_FOR_NEW_EVIDENCE"}}, "required": ["action_type"]},
      "then": {
        "properties": {
          "owner_gate": {
            "properties": {
              "required": {"const": false},
              "phrase_status": {"const": "NONE"}
            }
          },
          "action_payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["wake_on"],
            "properties": {
              "wake_on": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "EVIDENCE_EPOCH_CHANGED",
                    "ACTIVE_SCIENTIFIC_SPEND_TERMINAL",
                    "OWNER_DISCOVERY_REFRAME"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"action_type": {"const": "FORWARD_DATA_OPTION_READY"}}, "required": ["action_type"]},
      "then": {
        "properties": {
          "owner_gate": {
            "properties": {
              "required": {"const": true},
              "phrase_status": {"const": "PROPOSED_NOT_AUTHORITY"}
            }
          },
          "action_payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "hypothesis_or_hint_consumer",
              "population",
              "exclusions",
              "primary_x",
              "primary_y",
              "decision_time",
              "first_reliable_available_at_rule",
              "freshness_and_consumption_fence",
              "sample_floor",
              "missingness_policy",
              "provider_route_or_existing_capture",
              "provider_request_cap",
              "cash_cap_usd_cents",
              "wall_time_cap_seconds",
              "stop_rules",
              "raw_retention",
              "discovery_confirmation_role",
              "proposed_owner_execution_phrase"
            ],
            "properties": {
              "option_id": {"type": "string", "minLength": 1, "maxLength": 80},
              "hypothesis_or_hint_consumer": {"type": "string", "minLength": 1, "maxLength": 120},
              "population": {"type": "string", "minLength": 1, "maxLength": 2000},
              "exclusions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
              "primary_x": {"type": "string", "minLength": 1, "maxLength": 2000},
              "primary_y": {"type": "string", "minLength": 1, "maxLength": 2000},
              "decision_time": {"type": "string", "minLength": 1, "maxLength": 2000},
              "first_reliable_available_at_rule": {"type": "string", "minLength": 1, "maxLength": 2000},
              "freshness_and_consumption_fence": {"type": "string", "minLength": 1, "maxLength": 2000},
              "sample_floor": {"type": "integer", "minimum": 1},
              "missingness_policy": {"type": "string", "minLength": 1, "maxLength": 2000},
              "provider_route_or_existing_capture": {"type": "string", "minLength": 1, "maxLength": 200},
              "provider_request_cap": {"type": "integer", "minimum": 0},
              "cash_cap_usd_cents": {"type": "integer", "minimum": 0},
              "wall_time_cap_seconds": {"type": "integer", "minimum": 1},
              "stop_rules": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
              "raw_retention": {"type": "string", "minLength": 1, "maxLength": 2000},
              "discovery_confirmation_role": {"type": "string", "minLength": 1, "maxLength": 2000},
              "proposed_owner_execution_phrase": {"type": "string", "minLength": 1, "maxLength": 6000}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"action_type": {"const": "CAPABILITY_OPTION_READY"}}, "required": ["action_type"]},
      "then": {
        "properties": {
          "owner_gate": {
            "properties": {
              "required": {"const": true},
              "phrase_status": {"const": "PROPOSED_NOT_AUTHORITY"}
            }
          },
          "action_payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "named_consumer",
              "missing_capability",
              "reuse_search_summary",
              "bounded_delta",
              "managed_write_surface_hint",
              "cheapest_offline_acceptance",
              "stop_if",
              "proposed_owner_execution_phrase"
            ],
            "properties": {
              "option_id": {"type": "string", "minLength": 1, "maxLength": 80},
              "named_consumer": {"type": "string", "minLength": 1, "maxLength": 80},
              "missing_capability": {"type": "string", "minLength": 1, "maxLength": 2000},
              "reuse_search_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
              "bounded_delta": {"type": "string", "minLength": 1, "maxLength": 2000},
              "managed_write_surface_hint": {"type": "string", "minLength": 1, "maxLength": 2000},
              "cheapest_offline_acceptance": {"type": "string", "minLength": 1, "maxLength": 2000},
              "stop_if": {"type": "string", "minLength": 1, "maxLength": 2000},
              "proposed_owner_execution_phrase": {"type": "string", "minLength": 1, "maxLength": 6000}
            }
          }
        }
      }
    }
  ]
}
