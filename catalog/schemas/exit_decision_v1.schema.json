{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://catalog/schemas/exit_decision_v1.schema.json",
  "title": "SMIAL ExitDecision v1 — frozen hold/exit decision for PAPER/SHADOW execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "exit_decision_id",
    "position_id",
    "strategy_id",
    "strategy_version",
    "activation_epoch_id",
    "decision_at",
    "first_reliable_available_at",
    "action",
    "reason_code",
    "evidence_refs"
  ],
  "properties": {
    "schema": {"const": "smial.exit-decision"},
    "schema_version": {"const": "1.0"},
    "exit_decision_id": {
      "type": "string",
      "pattern": "^EXITDEC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "position_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "strategy_version": {
      "type": "string",
      "pattern": "^V[0-9]+$"
    },
    "activation_epoch_id": {
      "type": "string",
      "pattern": "^ACTIVATION-EPOCH-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "decision_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "first_reliable_available_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "action": {
      "enum": ["HOLD", "EXIT", "UNKNOWN", "BLOCKED"]
    },
    "reason_code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 6, "maxLength": 240}
    }
  }
}
