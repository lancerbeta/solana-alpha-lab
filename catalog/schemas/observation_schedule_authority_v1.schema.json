{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/observation_schedule_authority_v1.schema.json",
  "title": "SMIAL ObservationSchedule authority receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "authority_id",
    "schedule_sha256",
    "schedule_key",
    "activation_starts_at",
    "activation_stops_admitting_at",
    "provider_route_ids",
    "provider_calls_per_utc_day_max",
    "provider_calls_lifetime_max",
    "modeled_provider_credits_per_utc_day_max",
    "cash_usd_max",
    "retry",
    "fallback",
    "build_execute_wallet_signer_transaction",
    "expires_at",
    "phrase_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "smial.observation-schedule-authority"},
    "schema_version": {"const": "1.0"},
    "authority_id": {
      "type": "string",
      "pattern": "^AUTHZ-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "schedule_sha256": {"$ref": "#/$defs/sha256"},
    "schedule_key": {
      "type": "string",
      "pattern": "^OBS-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "activation_starts_at": {"$ref": "#/$defs/timestamp"},
    "activation_stops_admitting_at": {"$ref": "#/$defs/timestamp"},
    "provider_route_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
      }
    },
    "provider_calls_per_utc_day_max": {"type": "integer", "minimum": 1},
    "provider_calls_lifetime_max": {"type": "integer", "minimum": 1},
    "modeled_provider_credits_per_utc_day_max": {"type": "integer", "minimum": 1},
    "cash_usd_max": {"const": "0"},
    "retry": {"const": false},
    "fallback": {"const": false},
    "build_execute_wallet_signer_transaction": {"const": false},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "phrase_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
