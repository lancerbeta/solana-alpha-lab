{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/delivery_harness_task_contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "task_version", "status", "as_of", "owner", "allowed_routes", "expected_repository", "git_binding", "objective", "managed_write_set", "external_caps", "stop_conditions", "context_requirements"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,127}$"},
    "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["READY", "IN_PROGRESS", "IMPLEMENTED_UNVERIFIED", "VALIDATED", "DONE"]},
    "as_of": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "owner": {"type": "string", "minLength": 1},
    "allowed_routes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DIRECT_CODEX_DELIVERY", "DIRECT_CURSOR_DELIVERY", "DESIGN_ONLY"]}},
    "expected_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "git_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_base", "expected_upstream", "expected_upstream_oid", "expected_branch", "dirty_mode"],
      "properties": {
        "expected_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_upstream": {"type": "string", "minLength": 1},
        "expected_upstream_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "dirty_mode": {"enum": ["FORBIDDEN", "ALLOW_REPORTED"]}
      }
    },
    "objective": {"type": "string", "minLength": 20},
    "managed_write_set": {
      "oneOf": [
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        {"type": "object", "additionalProperties": false, "required": ["path", "heading"], "properties": {"path": {"type": "string", "minLength": 1}, "heading": {"const": "Managed write set"}}}
      ]
    },
    "external_caps": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "credentials", "external_system", "signing_or_financial_action", "cash_spend", "deployment"],
      "properties": {
        "network": {"type": "boolean"}, "credentials": {"type": "boolean"}, "external_system": {"type": "boolean"},
        "signing_or_financial_action": {"type": "boolean"}, "cash_spend": {"type": "boolean"}, "deployment": {"type": "boolean"}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_asset_ids", "l2_roles", "l3_roles", "roadmap_path", "exact_role_paths"],
      "properties": {
        "catalog_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "l2_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["LIFECYCLE", "EXTERNAL_ROUTE_KNOWLEDGE", "ARCHITECTURE_DECISIONS", "DELIVERY_EVIDENCE"]}},
        "l3_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["HISTORICAL_CONTEXT"]}},
        "roadmap_path": {"type": ["string", "null"]},
        "exact_role_asset_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["LIFECYCLE", "EXTERNAL_ROUTE_KNOWLEDGE", "ARCHITECTURE_DECISIONS", "DELIVERY_EVIDENCE", "HISTORICAL_CONTEXT"],
          "properties": {
            "LIFECYCLE": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "EXTERNAL_ROUTE_KNOWLEDGE": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "ARCHITECTURE_DECISIONS": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "DELIVERY_EVIDENCE": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "HISTORICAL_CONTEXT": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "exact_role_paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["LIFECYCLE", "EXTERNAL_ROUTE_KNOWLEDGE", "ARCHITECTURE_DECISIONS", "DELIVERY_EVIDENCE", "HISTORICAL_CONTEXT"],
          "properties": {
            "LIFECYCLE": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "EXTERNAL_ROUTE_KNOWLEDGE": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "ARCHITECTURE_DECISIONS": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "DELIVERY_EVIDENCE": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "HISTORICAL_CONTEXT": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
