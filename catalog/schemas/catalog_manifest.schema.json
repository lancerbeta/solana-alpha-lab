{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smial:catalog:manifest:1.0",
  "title": "SMIAL Project Asset Catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "as_of",
    "implementation_status",
    "root_resolver",
    "policies",
    "mandatory_asset_ids",
    "deferred_capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "implementation_status": {
      "enum": [
        "FOUNDATION_IMPLEMENTED_UNVERIFIED",
        "VALIDATED_ACTIVE"
      ]
    },
    "root_resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_registries",
        "query_registries",
        "schemas",
        "commands"
      ],
      "properties": {
        "asset_registries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
          }
        },
        "query_registries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validate",
            "resolve_asset",
            "resolve_query"
          ],
          "properties": {
            "validate": {
              "$ref": "#/$defs/command"
            },
            "resolve_asset": {
              "$ref": "#/$defs/command"
            },
            "resolve_query": {
              "$ref": "#/$defs/command"
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_paths",
        "secrets",
        "raw_bytes",
        "duplicate_ids",
        "broken_references",
        "unregistered_mandatory_output",
        "self_integrity",
        "query_write_effects",
        "graph_database"
      ],
      "properties": {
        "absolute_paths": {
          "const": "FORBIDDEN"
        },
        "secrets": {
          "const": "FORBIDDEN"
        },
        "raw_bytes": {
          "const": "OUTSIDE_CATALOG"
        },
        "duplicate_ids": {
          "const": "FAIL"
        },
        "broken_references": {
          "const": "FAIL"
        },
        "unregistered_mandatory_output": {
          "const": "CATALOG_GAP"
        },
        "self_integrity": {
          "const": "ACCEPTED_GIT_COMMIT_PLUS_EXTERNAL_RECEIPT"
        },
        "query_write_effects": {
          "const": "FORBIDDEN"
        },
        "graph_database": {
          "const": "DEFERRED_UNTIL_MEASURED_NEED_ADR"
        }
      }
    },
    "mandatory_asset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
      }
    },
    "deferred_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PRE_GIT_IMPORT",
          "GENERATED_PROJECT_MAP",
          "GENERATED_EDGE_PROJECTION",
          "REGISTRY_SKELETONS",
          "REMOTE_CI",
          "CLEAN_CLONE",
          "CODEX_PILOT",
          "GRAPH_DATABASE"
        ]
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
