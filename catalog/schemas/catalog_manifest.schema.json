{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smial:catalog:manifest:1.1",
  "title": "SMIAL Project Asset Catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "as_of",
    "implementation_status",
    "current_checkpoint",
    "root_resolver",
    "policies",
    "mandatory_asset_ids",
    "deferred_capabilities"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "implementation_status": {
      "enum": [
        "FOUNDATION_IMPLEMENTED_UNVERIFIED",
        "VALIDATED_ACTIVE"
      ]
    },
    "current_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets",
        "asset_registries",
        "schemas",
        "queries",
        "lifecycle_registries",
        "lifecycle_records"
      ],
      "properties": {
        "assets": {
          "type": "integer",
          "minimum": 1
        },
        "asset_registries": {
          "type": "integer",
          "minimum": 1
        },
        "schemas": {
          "type": "integer",
          "minimum": 1
        },
        "queries": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycle_registries": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycle_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "canonical_bindings": {
      "$ref": "#/$defs/canonical_bindings"
    },
    "root_resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_registries",
        "query_registries",
        "lifecycle_registries",
        "schemas",
        "commands"
      ],
      "properties": {
        "asset_registries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
          }
        },
        "query_registries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
          }
        },
        "lifecycle_registries": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[A-Za-z0-9._/@{}-]+(?:/[A-Za-z0-9._/@{}-]+)*$"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validate",
            "resolve_asset",
            "resolve_query",
            "generate_navigation",
            "check_generated_navigation"
          ],
          "properties": {
            "validate": {
              "$ref": "#/$defs/command"
            },
            "resolve_asset": {
              "$ref": "#/$defs/command"
            },
            "resolve_query": {
              "$ref": "#/$defs/command"
            },
            "generate_navigation": {
              "$ref": "#/$defs/command"
            },
            "check_generated_navigation": {
              "$ref": "#/$defs/command"
            },
            "resolve_binding": {
              "$ref": "#/$defs/command"
            },
            "search_assets": {
              "$ref": "#/$defs/command"
            },
            "related_assets": {
              "$ref": "#/$defs/command"
            },
            "search_routes": {
              "$ref": "#/$defs/command"
            },
            "resolve_route": {
              "$ref": "#/$defs/command"
            },
            "list_routes": {
              "$ref": "#/$defs/command"
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_paths",
        "secrets",
        "raw_bytes",
        "duplicate_ids",
        "broken_references",
        "unregistered_mandatory_output",
        "self_integrity",
        "query_write_effects",
        "graph_database",
        "pre_git_availability",
        "external_bundle_bytes",
        "architecture_intent_claim"
      ],
      "properties": {
        "absolute_paths": {
          "const": "FORBIDDEN"
        },
        "secrets": {
          "const": "FORBIDDEN"
        },
        "raw_bytes": {
          "const": "OUTSIDE_CATALOG"
        },
        "duplicate_ids": {
          "const": "FAIL"
        },
        "broken_references": {
          "const": "FAIL"
        },
        "unregistered_mandatory_output": {
          "const": "CATALOG_GAP"
        },
        "self_integrity": {
          "const": "ACCEPTED_GIT_COMMIT_PLUS_EXTERNAL_RECEIPT"
        },
        "query_write_effects": {
          "const": "FORBIDDEN"
        },
        "graph_database": {
          "const": "DEFERRED_UNTIL_MEASURED_NEED_ADR"
        },
        "pre_git_availability": {
          "const": "PRESERVE_FIRST_RELIABLE_AVAILABLE_AT"
        },
        "external_bundle_bytes": {
          "const": "OUTSIDE_GIT_REGISTER_BY_HASH"
        },
        "architecture_intent_claim": {
          "const": "DIRECTION_ONLY_UNTIL_IMPLEMENTED_EVIDENCE"
        }
      }
    },
    "mandatory_asset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
      }
    },
    "deferred_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "PRE_GIT_IMPORT",
          "GENERATED_PROJECT_MAP",
          "GENERATED_EDGE_PROJECTION",
          "REGISTRY_SKELETONS",
          "REMOTE_CI",
          "CLEAN_CLONE",
          "CODEX_PILOT",
          "GRAPH_DATABASE"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "canonical_bindings": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["canonical_bindings"],
        "properties": {
          "root_resolver": {
            "type": "object",
            "properties": {
              "commands": {
                "type": "object",
                "required": [
                  "validate",
                  "resolve_asset",
                  "resolve_query",
                  "generate_navigation",
                  "check_generated_navigation",
                  "resolve_binding",
                  "search_assets",
                  "related_assets",
                  "search_routes",
                  "resolve_route",
                  "list_routes"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canonical_bindings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/canonical_binding"
      }
    },
    "canonical_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_asset_id",
        "semantics",
        "rationale"
      ],
      "properties": {
        "target_asset_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "expected_asset_type": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "const": "CURRENT_AT_COMMIT"
        },
        "rationale": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        },
        "current_use_evidence_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          }
        }
      }
    }
  }
}
