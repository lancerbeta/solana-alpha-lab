{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/forge_run_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "run_identity_sha256",
    "owner_class",
    "next_action",
    "owner_final",
    "input_receipt_sha256",
    "visible_cohort_ids",
    "frozen_representation_ids",
    "stages",
    "legacy_epoch_sha256",
    "writes",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "smial.forge-run-receipt"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_class": {
      "enum": [
        "FORGE_RUN_IN_PROGRESS",
        "OWNER_FINAL",
        "INPUT_NOT_READY",
        "OBSERVABILITY_BLOCKED"
      ]
    },
    "next_action": {"type": "string", "minLength": 1},
    "owner_final": {
      "type": ["string", "null"],
      "enum": [
        null,
        "OWNER_CANDIDATE",
        "SEARCH_EXHAUSTED_CURRENT_EVIDENCE",
        "NON_SCIENTIFIC_STOP",
        "INPUT_NOT_READY",
        "OBSERVABILITY_BLOCKED",
        "KEEP_PAUSE",
        "CONTROL_REQUIRED"
      ]
    },
    "input_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "visible_cohort_ids": {"type": "array", "items": {"type": "string"}},
    "used_cohort_ids": {"type": "array", "items": {"type": "string"}},
    "frozen_representation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "representation_id",
          "execution_status",
          "effective_terminal",
          "input_scope"
        ],
        "properties": {
          "representation_id": {"type": "string"},
          "execution_status": {
            "enum": ["EXECUTED", "REUSED_VALID", "NOT_RUN", "BLOCKED"]
          },
          "effective_terminal": {"type": ["string", "null"]},
          "input_scope": {"type": "string"},
          "session_id": {"type": ["string", "null"]},
          "session_state": {"type": ["string", "null"]},
          "selected_candidate_id": {"type": ["string", "null"]},
          "runner_up_candidate_id": {"type": ["string", "null"]},
          "stage_ref_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "used_cohort_ids": {"type": "array", "items": {"type": "string"}},
          "draft_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "reason_code": {"type": ["string", "null"]}
        }
      }
    },
    "legacy_epoch_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "control_session_id": {"type": ["string", "null"]},
    "blocking_reason_codes": {"type": "array", "items": {"type": "string"}},
    "owner_readout": {"type": "string"},
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_store", "forge_run", "session"],
      "properties": {
        "research_store": {"type": "integer", "minimum": 0},
        "forge_run": {"type": "integer", "minimum": 0},
        "session": {"type": "integer", "minimum": 0}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "persisted_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
