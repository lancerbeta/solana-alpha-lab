{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/forge_run_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "run_identity_sha256",
    "owner_class",
    "next_action",
    "owner_final",
    "input_receipt_sha256",
    "visible_cohort_ids",
    "frozen_representation_ids",
    "stages",
    "legacy_epoch_sha256",
    "writes",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "smial.forge-run-receipt"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "run_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_focus": {"type": "string", "minLength": 1},
    "owner_class": {
      "enum": [
        "FORGE_RUN_IN_PROGRESS",
        "OWNER_FINAL",
        "INPUT_NOT_READY",
        "OBSERVABILITY_BLOCKED"
      ]
    },
    "next_action": {"type": "string", "minLength": 1},
    "owner_final": {
      "type": ["string", "null"],
      "description": "Owner-final of the bounded forge-run. KEEP_PAUSE and CONTROL_SURFACE_REQUIRED are NEXT (owner_final null), not DONE enums. Historical CONTROL_REQUIRED owner-final is retired.",
      "enum": [
        null,
        "OWNER_CANDIDATE",
        "SEARCH_EXHAUSTED_CURRENT_EVIDENCE",
        "NON_SCIENTIFIC_STOP",
        "INPUT_NOT_READY",
        "OBSERVABILITY_BLOCKED"
      ]
    },
    "input_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "visible_cohort_ids": {"type": "array", "items": {"type": "string"}},
    "used_cohort_ids": {"type": "array", "items": {"type": "string"}},
    "frozen_representation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "frozen_representation_versions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "representation_id",
          "execution_status",
          "effective_terminal",
          "input_scope"
        ],
        "properties": {
          "representation_id": {"type": "string"},
          "representation_semantic_version": {"type": ["string", "null"]},
          "representation_payload_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "scientific_slot_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "execution_binding_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "execution_provenance_status": {
            "type": ["string", "null"],
            "enum": [
              null,
              "VERIFIED_EXECUTION_BINDING",
              "HISTORICAL_READBACK_UNKNOWN",
              "NOT_APPLICABLE",
              "EXECUTION_BINDING_CONFLICT"
            ]
          },
          "control_session_id": {"type": ["string", "null"]},
          "model_provenance_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "memory_eligibility_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "market_evidence_epoch_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "capability_epoch_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "execution_status": {
            "enum": ["EXECUTED", "REUSED_VALID", "NOT_RUN", "BLOCKED"]
          },
          "effective_terminal": {"type": ["string", "null"]},
          "input_scope": {"type": "string"},
          "evidence_surface_mode": {"type": ["string", "null"]},
          "session_id": {"type": ["string", "null"]},
          "session_state": {"type": ["string", "null"]},
          "selected_candidate_id": {"type": ["string", "null"]},
          "runner_up_candidate_id": {"type": ["string", "null"]},
          "stage_ref_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "used_cohort_ids": {"type": "array", "items": {"type": "string"}},
          "draft_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "reason_code": {"type": ["string", "null"]},
          "critic_terminal": {"type": ["string", "null"]},
          "critic_decisive_reason": {"type": ["string", "null"]},
          "critic_identity": {"type": ["string", "null"]},
          "declined_candidate_ids": {"type": "array", "items": {"type": "string"}},
          "candidate_mechanism": {"type": ["string", "null"]}
        }
      }
    },
    "legacy_epoch_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "market_evidence_epoch_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_epoch_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "session_id": {"type": ["string", "null"]},
    "scientific_slot_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_binding_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_provenance_status": {
      "type": ["string", "null"],
      "enum": [
        null,
        "VERIFIED_EXECUTION_BINDING",
        "HISTORICAL_READBACK_UNKNOWN",
        "NOT_APPLICABLE",
        "EXECUTION_BINDING_CONFLICT"
      ]
    },
    "control_session_id": {"type": ["string", "null"]},
    "blocking_reason_codes": {"type": "array", "items": {"type": "string"}},
    "discovery_contract_version": {"type": ["string", "null"]},
    "owner_readout": {"type": "string"},
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_store", "forge_run", "session"],
      "properties": {
        "research_store": {"type": "integer", "minimum": 0},
        "forge_run": {"type": "integer", "minimum": 0},
        "session": {"type": "integer", "minimum": 0}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "persisted_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
