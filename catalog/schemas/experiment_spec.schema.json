{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/experiment_spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "experiment_id",
    "hypothesis_version",
    "question",
    "estimand",
    "population",
    "data_requirements",
    "capabilities",
    "falsifier",
    "method",
    "parameters",
    "evidence_budget",
    "holdout_policy",
    "terminal_outcomes"
  ],
  "properties": {
    "schema": {"const": "smial.experiment-spec"},
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "hypothesis_version": {"type": "string", "pattern": "^HYP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "question": {"type": "string", "minLength": 12, "maxLength": 500},
    "estimand": {"type": "string", "minLength": 8, "maxLength": 240},
    "population": {"type": "string", "minLength": 8, "maxLength": 240},
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "kind", "path"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 3, "maxLength": 120},
          "kind": {
            "enum": [
              "GIT_CANONICAL_RECEIPT",
              "GIT_CANONICAL_ACCEPTANCE",
              "CATALOG_ASSET",
              "CAPTURE_POLICY",
              "PROVIDER_BOUNDED_CAPTURE"
            ]
          },
          "path": {"type": "string", "minLength": 8, "maxLength": 240},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "GIT_CANONICAL_RECEIPT",
                    "GIT_CANONICAL_ACCEPTANCE",
                    "CATALOG_ASSET",
                    "CAPTURE_POLICY"
                  ]
                }
              }
            },
            "then": {"required": ["sha256"]}
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CAP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"}
    },
    "required_feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^FEAT-[A-Z0-9]+(?:-[A-Z0-9]+)+$"}
    },
    "falsifier": {"type": "string", "minLength": 8, "maxLength": 240},
    "method": {"type": "string", "minLength": 3, "maxLength": 80},
    "parameters": {"type": "object"},
    "evidence_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_api_rpc_wss_calls"],
      "properties": {
        "provider_api_rpc_wss_calls": {"type": "integer", "minimum": 0, "maximum": 62}
      }
    },
    "holdout_policy": {"type": "string", "minLength": 8, "maxLength": 240},
    "terminal_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 80}
    }
  }
}
