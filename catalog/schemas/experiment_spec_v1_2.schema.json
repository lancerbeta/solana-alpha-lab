{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smial.local/schemas/experiment_spec_v1_2.schema.json",
  "title": "SMIAL ExperimentSpec v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "experiment_id",
    "hypothesis_version",
    "question",
    "estimand",
    "population",
    "data_requirements",
    "capabilities",
    "falsifier",
    "method",
    "parameters",
    "evidence_budget",
    "holdout_policy",
    "terminal_outcomes",
    "data_bindings",
    "query_recipe_ids",
    "capability_id",
    "parameter_schema_asset_id",
    "as_of",
    "availability_cutoff",
    "what_changed",
    "observation_request"
  ],
  "properties": {
    "schema": {"const": "smial.experiment-spec"},
    "schema_version": {"const": "1.2"},
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "hypothesis_version": {
      "type": "string",
      "pattern": "^HYP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "question": {"type": "string", "minLength": 12, "maxLength": 500},
    "estimand": {"type": "string", "minLength": 8, "maxLength": 240},
    "population": {"type": "string", "minLength": 8, "maxLength": 240},
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "kind", "path"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 3, "maxLength": 120},
          "kind": {
            "enum": [
              "GIT_CANONICAL_RECEIPT",
              "GIT_CANONICAL_ACCEPTANCE",
              "CATALOG_ASSET",
              "CAPTURE_POLICY",
              "PROVIDER_BOUNDED_CAPTURE"
            ]
          },
          "path": {"type": "string", "minLength": 8, "maxLength": 240},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "GIT_CANONICAL_RECEIPT",
                    "GIT_CANONICAL_ACCEPTANCE",
                    "CATALOG_ASSET",
                    "CAPTURE_POLICY"
                  ]
                }
              },
              "required": ["kind"]
            },
            "then": {"required": ["sha256"]}
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability_id"}
    },
    "required_feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^FEAT-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
      }
    },
    "falsifier": {"type": "string", "minLength": 8, "maxLength": 240},
    "method": {"type": "string", "minLength": 3, "maxLength": 80},
    "parameters": {"type": "object"},
    "evidence_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_api_rpc_wss_calls"],
      "properties": {
        "provider_api_rpc_wss_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 62
        }
      }
    },
    "holdout_policy": {"type": "string", "minLength": 8, "maxLength": 240},
    "terminal_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 80}
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "source_kind",
          "stable_id",
          "expected_content_sha256_or_dataset_fingerprint"
        ],
        "properties": {
          "binding_id": {"$ref": "#/$defs/stable_id"},
          "source_kind": {
            "enum": [
              "CATALOG_ASSET",
              "DATASET_MANIFEST",
              "RESEARCH_ARTIFACT"
            ]
          },
          "stable_id": {"$ref": "#/$defs/stable_id"},
          "expected_content_sha256_or_dataset_fingerprint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,255}$"
          }
        }
      }
    },
    "query_recipe_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_id"}
    },
    "capability_id": {"$ref": "#/$defs/capability_id"},
    "parameter_schema_asset_id": {"$ref": "#/$defs/stable_id"},
    "as_of": {"$ref": "#/$defs/timestamp"},
    "availability_cutoff": {"$ref": "#/$defs/timestamp"},
    "what_changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
      }
    },
    "observation_request": {"$ref": "#/$defs/observation_request"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "field_id": {
      "type": "string",
      "pattern": "^FIELD-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "observation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_mode",
        "schedule_key",
        "activation",
        "source_poll",
        "population",
        "sampling",
        "x_point",
        "y_points",
        "missingness",
        "disappearance",
        "budgets",
        "retention",
        "authority",
        "outputs",
        "requested_evidence_role"
      ],
      "properties": {
        "collection_mode": {
          "enum": ["REUSE_ONLY", "REUSE_OR_SCHEDULE", "SCHEDULE_ONLY"]
        },
        "schedule_key": {
          "type": "string",
          "pattern": "^OBS-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["starts_at", "stops_admitting_at", "cadence_alignment"],
          "properties": {
            "starts_at": {"$ref": "#/$defs/timestamp"},
            "stops_admitting_at": {"$ref": "#/$defs/timestamp"},
            "cadence_alignment": {"const": "UTC_EPOCH"}
          }
        },
        "source_poll": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primitive_id", "query_profile_id", "period_seconds"],
          "properties": {
            "primitive_id": {
              "type": "string",
              "pattern": "^PRIM-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
            },
            "query_profile_id": {
              "type": "string",
              "pattern": "^QUERY-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
            },
            "period_seconds": {"enum": [60, 300, 900, 3600, 86400]}
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity_type",
            "entity_key_field_id",
            "anchor_field_id",
            "scheduling_fallback",
            "source_predicates",
            "x_eligibility_predicates"
          ],
          "properties": {
            "entity_type": {"const": "TOKEN_MINT"},
            "entity_key_field_id": {"$ref": "#/$defs/field_id"},
            "anchor_field_id": {"$ref": "#/$defs/field_id"},
            "scheduling_fallback": {"enum": ["FIRST_SEEN_AT_ONLY", "NONE"]},
            "source_predicates": {
              "type": "array",
              "items": {"$ref": "#/$defs/predicate"}
            },
            "x_eligibility_predicates": {
              "type": "array",
              "items": {"$ref": "#/$defs/predicate"}
            }
          }
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "seed",
            "inclusion_probability",
            "max_candidates_per_utc_day",
            "max_members_per_utc_day",
            "overflow_state"
          ],
          "properties": {
            "policy": {"enum": ["ALL_UNDER_CAP", "DETERMINISTIC_HASH_BERNOULLI"]},
            "seed": {"type": "string", "minLength": 4, "maxLength": 120},
            "inclusion_probability": {
              "type": "string",
              "pattern": "^(0\\.[0-9]{1,8}|1(\\.0{1,8})?)$"
            },
            "max_candidates_per_utc_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "max_members_per_utc_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "overflow_state": {"const": "NOT_SELECTED_CAPACITY"}
          }
        },
        "x_point": {"$ref": "#/$defs/point"},
        "y_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/point"}
        },
        "missingness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value_policy",
            "unknown_is_zero",
            "missing_point_deletes_member",
            "continue_later_points_after_missing"
          ],
          "properties": {
            "value_policy": {"const": "TYPED_NULL_NO_IMPUTATION"},
            "unknown_is_zero": {"const": false},
            "missing_point_deletes_member": {"const": false},
            "continue_later_points_after_missing": {"type": "boolean"}
          }
        },
        "disappearance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "single_absence_is_terminal",
            "explicit_registered_terminal"
          ],
          "properties": {
            "default": {
              "enum": ["CONTINUE_UNTIL_FINAL_HORIZON", "CENSOR_REMAINING_POINTS"]
            },
            "single_absence_is_terminal": {"const": false},
            "explicit_registered_terminal": {"const": "CENSOR_REMAINING_POINTS"}
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cash_usd_max",
            "provider_calls_per_tick_max",
            "provider_calls_per_utc_day_max",
            "provider_calls_lifetime_max",
            "modeled_provider_credits_per_utc_day_max",
            "raw_bytes_per_utc_day_max",
            "canonical_bytes_lifetime_max",
            "min_provider_pace_seconds",
            "retry",
            "fallback"
          ],
          "properties": {
            "cash_usd_max": {"const": "0"},
            "provider_calls_per_tick_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "provider_calls_per_utc_day_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "provider_calls_lifetime_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "modeled_provider_credits_per_utc_day_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "raw_bytes_per_utc_day_max": {"type": "integer", "minimum": 1},
            "canonical_bytes_lifetime_max": {"type": "integer", "minimum": 1},
            "min_provider_pace_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "retry": {"const": false},
            "fallback": {"const": false}
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_retention_days",
            "canonical_panel_retention",
            "active_journal_backup"
          ],
          "properties": {
            "raw_retention_days": {
              "type": "integer",
              "minimum": 8,
              "maximum": 365
            },
            "canonical_panel_retention": {"const": "IMMUTABLE"},
            "active_journal_backup": {"const": "REQUIRED"}
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "activation_receipt_required"],
          "properties": {
            "profile_id": {
              "type": "string",
              "pattern": "^AUTH-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
            },
            "activation_receipt_required": {"const": true}
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "membership_schema_id",
            "observation_index_schema_id",
            "partition_period",
            "publication"
          ],
          "properties": {
            "membership_schema_id": {"$ref": "#/$defs/stable_id"},
            "observation_index_schema_id": {"$ref": "#/$defs/stable_id"},
            "partition_period": {"const": "UTC_DAY"},
            "publication": {"const": "MANIFEST_LAST"}
          }
        },
        "requested_evidence_role": {
          "enum": [
            "PROSPECTIVE_OOS",
            "PROSPECTIVE_OUTCOME_BLIND_CONDITIONAL",
            "EXPLORATORY_REUSE",
            "CONSUMED_PRIOR_EVIDENCE"
          ]
        },
        "estimator_id": {
          "type": "string",
          "pattern": "^EST-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "operator"],
      "properties": {
        "field_id": {"$ref": "#/$defs/field_id"},
        "operator": {"enum": ["EQ", "NEQ", "GT", "GTE", "LT", "LTE"]},
        "value_text": {"type": "string", "minLength": 1, "maxLength": 120},
        "value_decimal": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]{1,18})?$"
        }
      },
      "oneOf": [
        {"required": ["value_text"], "not": {"required": ["value_decimal"]}},
        {"required": ["value_decimal"], "not": {"required": ["value_text"]}}
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "due_offset_seconds",
        "allowed_lateness_seconds",
        "bundle_ids"
      ],
      "properties": {
        "point_id": {"type": "string", "pattern": "^[XY][0-9]{1,7}$"},
        "due_offset_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000
        },
        "allowed_lateness_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000
        },
        "bundle_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^BUNDLE-[A-Z0-9]+(?:-[A-Z0-9]+)+$"
          }
        }
      }
    }
  }
}
