[Unit]
Description=HOT90 closed-day archive catch-up at 01:15 UTC and every 6h
# Template only — do NOT install/enable from this Git PR.

[Timer]
OnCalendar=*-*-* 01:15:00 UTC
OnCalendar=*-*-* 07:15:00 UTC
OnCalendar=*-*-* 13:15:00 UTC
OnCalendar=*-*-* 19:15:00 UTC
Persistent=true
Unit=factory-hot90-closed-day-archive.service

[Install]
WantedBy=timers.target
