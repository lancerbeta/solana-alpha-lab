[Unit]
Description=HOT90 closed-day archive catch-up at 04:15 UTC and every 6h
# Template only — do NOT install/enable from this Git PR.

[Timer]
OnCalendar=*-*-* 04:15:00 UTC
OnCalendar=*-*-* 10:15:00 UTC
OnCalendar=*-*-* 16:15:00 UTC
OnCalendar=*-*-* 22:15:00 UTC
Persistent=true
Unit=factory-hot90-closed-day-archive.service

[Install]
WantedBy=timers.target
