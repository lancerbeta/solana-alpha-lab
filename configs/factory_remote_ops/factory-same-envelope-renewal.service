[Unit]
Description=Renew the same observation envelope when the admission window is inside 72h
Documentation=docs/operator/FACTORY_LIFECYCLE_COLLECTOR.md

[Service]
Type=oneshot
WorkingDirectory=/opt/solana-alpha-lab
ExecStart=/usr/bin/uv run --locked --managed-python python -B scripts/renew_same_observation_envelope.py --runtime-config configs/observation_schedule_runtime_v1.yaml
NoNewPrivileges=true
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=256M
