[Unit]
Description=Factory local operability watch (incident/recovery)
Documentation=docs/operator/FACTORY_UNATTENDED_OPERABILITY.md
After=network-online.target
# Template only — install/enable only after owner-gated production commissioning.

[Service]
Type=oneshot
WorkingDirectory=/opt/solana-alpha-lab
EnvironmentFile=-/etc/solana-alpha-lab/secrets.env
ExecStart=/usr/bin/uv run --locked --managed-python python -B scripts/factory_operability_watch.py --mode emit
NoNewPrivileges=true
