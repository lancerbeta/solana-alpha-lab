[Unit]
Description=Factory ObservationSchedule tick --once
Documentation=docs/tasks/DECLARATIVE_OBSERVATION_SCHEDULE_BRIDGE_V1.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/solana-alpha-lab
Environment=OBSERVATION_SCHEDULE_RUNTIME_CONFIG=/opt/solana-alpha-lab/configs/observation_schedule_runtime_v1.yaml
ExecStart=/usr/bin/uv run --locked --managed-python python -B scripts/observation_schedule.py tick --once --runtime-config ${OBSERVATION_SCHEDULE_RUNTIME_CONFIG}
NoNewPrivileges=true
