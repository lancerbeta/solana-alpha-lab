{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smial:github-baton:atom-contract:1.0",
  "title": "SMIAL GitHub Baton Atom Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "automation_schema",
    "schema_version",
    "contract_id",
    "contract_revision",
    "created_at",
    "created_by_control_plane",
    "project",
    "repository",
    "objective",
    "inputs",
    "execution",
    "managed_write_set",
    "explicit_exclusions",
    "acceptance",
    "stop_conditions",
    "rollback",
    "return_contract"
  ],
  "properties": {
    "automation_schema": {
      "const": "smial.github_baton.atom_contract"
    },
    "schema_version": {
      "const": "1.0"
    },
    "contract_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,119}$"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "created_by_control_plane": {
      "const": "ChatGPT_Project_GPT_Control_Plane"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "task_id",
        "atom_id",
        "canonical_status_snapshot"
      ],
      "properties": {
        "project_id": {
          "const": "SMIAL"
        },
        "task_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "atom_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "canonical_status_snapshot": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "base_branch",
        "base_head",
        "base_tree",
        "expected_upstream",
        "require_clean_worktree"
      ],
      "properties": {
        "full_name": {
          "const": "lancerbeta/solana-alpha-lab"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "base_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expected_upstream": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        },
        "require_clean_worktree": {
          "type": "boolean"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "why_now",
        "cheapest_falsifier"
      ],
      "properties": {
        "result": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "why_now": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "cheapest_falsifier": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_asset_ids",
        "repository_paths",
        "external_fact_refs"
      ],
      "properties": {
        "catalog_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        },
        "repository_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        },
        "external_fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "authority_class",
        "network",
        "credentials",
        "dependency_changes_allowed",
        "cash_cap_usd"
      ],
      "properties": {
        "surface": {
          "const": "CURSOR_LOCAL"
        },
        "authority_class": {
          "enum": [
            "READ_ONLY",
            "LOCAL_WRITE",
            "COMMIT",
            "PUSH_REMOTE_SETTINGS"
          ]
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "allowed_targets"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "allowed_targets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "references_only"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "references_only": {
              "type": "boolean"
            }
          }
        },
        "dependency_changes_allowed": {
          "type": "boolean"
        },
        "cash_cap_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "managed_write_set": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 260
      }
    },
    "explicit_exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 260
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targeted_commands",
        "full_validation_command",
        "semantic_invariants",
        "required_receipts"
      ],
      "properties": {
        "targeted_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "full_validation_command": {
          "const": "uv run --locked --managed-python python -B scripts/validate_ci.py"
        },
        "semantic_invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required_receipts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "destructive_actions_allowed"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "destructive_actions_allowed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_comment_required",
        "draft_pr_required",
        "exact_artifacts"
      ],
      "properties": {
        "issue_comment_required": {
          "type": "boolean"
        },
        "draft_pr_required": {
          "type": "boolean"
        },
        "exact_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          }
        }
      }
    }
  }
}
